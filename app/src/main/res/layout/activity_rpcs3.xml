<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:keepScreenOn="true"
    tools:context=".RPCSXActivity">

    <FrameLayout
        android:id="@+id/surfaceHost"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- The monitor is visual-only. Its custom host rejects the entire touch
         dispatch so the controller remains the gameplay target even when visible.
         It intentionally precedes PadOverlay so controller controls draw above it. -->
    <com.zenithblue.sambas3.ui.TouchThroughComposeView
        android:id="@+id/monitoringOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:clickable="false"
        android:focusable="false" />

    <com.zenithblue.sambas3.overlay.PadOverlay
        android:id="@+id/padOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Live logs sit above pad, below utility buttons and the in-game menu.
         Locked mode is touch-through so gameplay still reaches PadOverlay. -->
    <com.zenithblue.sambas3.ui.InteractivePassThroughComposeView
        android:id="@+id/liveLogsOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:clickable="false"
        android:focusable="false" />

    <!-- Runtime shader hints mirror the core's bottom-left toast, but remain
         visual-only so controller and touch input keep reaching gameplay. -->
    <com.zenithblue.sambas3.ui.TouchThroughComposeView
        android:id="@+id/shaderToastOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:clickable="false"
        android:focusable="false" />

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/ingameOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/osc_toggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="?android:attr/actionBarItemBackground"
        android:contentDescription="@string/osc_toggle_cd"
        android:padding="8dp"
        android:src="@drawable/ic_show_osc"
        app:tint="#40FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="10dp" />

    <ImageButton
        android:id="@+id/menu_toggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="?android:attr/actionBarItemBackground"
        android:contentDescription="@string/home_menu_toggle_cd"
        android:padding="8dp"
        android:src="@drawable/ic_home_menu"
        app:tint="#40FFFFFF"
        app:layout_constraintBottom_toTopOf="@id/osc_toggle"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="10dp" />

    <FrameLayout
        android:id="@+id/transitionOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <ImageView
            android:id="@+id/transitionFrame"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#A6000000" />

        <LinearLayout
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/transitionLogo"
                android:layout_width="220dp"
                android:layout_height="124dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:visibility="gone" />

            <TextView
                android:id="@+id/transitionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="Saving Slot..."
                android:textColor="#FFFFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/transitionDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:textColor="#BFFFFFFF"
                android:textSize="14sp"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/transitionProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="220dp"
                android:layout_height="4dp"
                android:layout_marginTop="18dp"
                android:indeterminate="true"
                android:indeterminateTint="#FFD36A" />
        </LinearLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
