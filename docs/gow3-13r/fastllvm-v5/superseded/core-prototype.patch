 		// while the fast tier (make_fast_llvm_recompiler()) is strictly x86_64-only (ARCH_X64).
 		// No ARM SPU tier-1 fast compiler is claimed or enabled.
 		// Ticket J07: SPU single-flight state machine deduplicates block compilation across all 6 concurrent SPU workers.
-#if defined(ARCH_X64)
+#if defined(ARCH_X64) || defined(ARCH_ARM64)
 		jit = spu_recompiler_base::make_fast_llvm_recompiler();
-#elif defined(ARCH_ARM64)
-		jit = spu_recompiler_base::make_llvm_recompiler();
 #else
 #error "Unimplemented"
 #endif
