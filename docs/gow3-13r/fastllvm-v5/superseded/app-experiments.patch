+@@ -7785,11 +7785,11 @@ struct spu_fast : public spu_recompiler_base
+ 
+ 	virtual spu_function_t compile(spu_program&& _func) override
+ 	{
+-#if !defined(ARCH_X64)
++#if !defined(ARCH_X64) && !defined(ARCH_ARM64)
+ 		UNUSED(_func);
