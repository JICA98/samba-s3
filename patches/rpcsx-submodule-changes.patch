+extern "C" std::string _rpcsx_getPerfMetricsJson()
+{
+    std::lock_guard lock(g_android_perf.mutex);
+    if (!g_android_perf.enabled)
+        return nlohmann::json{{"version", 1}, {"enabled", false}}.dump();
+
+    const u64 now = get_system_time();
+    if (g_android_perf.last_update_us != 0 && now - g_android_perf.last_update_us < g_android_perf.interval_ms * 1000ull)
+    {
+        android_perf_log_crosscheck_locked(now);
+        return android_perf_snapshot_json().dump();
+    }
+
+    const auto rsx = g_fxo ? g_fxo->try_get<rsx::thread>() : nullptr;
+    if (!rsx || (!Emu.IsRunning() && !Emu.IsPaused()))
+    {
+        android_perf_log_crosscheck_locked(now);
+        return android_perf_snapshot_json().dump();
+    }
+
+    const u64 vblank = rsx->vblank_count.load();
+    if (g_android_perf.last_timestamp_us != 0 && now > g_android_perf.last_timestamp_us)
+    {
+        const u64 elapsed = now - g_android_perf.last_timestamp_us;
+        const u64 frames = vblank >= g_android_perf.last_vblank ? vblank - g_android_perf.last_vblank : 0;
+        g_android_perf.fps = static_cast<f32>(frames) * 1'000'000.f / static_cast<f32>(elapsed);
+        g_android_perf.frametime_ms = frames ? static_cast<f32>(elapsed) / static_cast<f32>(frames) / 1000.f : g_android_perf.frametime_ms;
+        g_android_perf.fps_samples.push_back(g_android_perf.fps);
+        g_android_perf.frametime_samples.push_back(g_android_perf.frametime_ms);
+        while (g_android_perf.fps_samples.size() > 60) g_android_perf.fps_samples.pop_front();
+        while (g_android_perf.frametime_samples.size() > 60) g_android_perf.frametime_samples.pop_front();
+    }
+    g_android_perf.last_vblank = vblank;
+    g_android_perf.last_timestamp_us = now;
+    g_android_perf.last_update_us = now;
+    g_android_perf.total_threads = utils::cpu_stats::get_current_thread_count();
+    g_android_perf.ppu_threads = idm::select<named_thread<ppu_thread>>([&](u32, named_thread<ppu_thread>& ppu)
+    {
+        g_android_perf.ppu_cycles += thread_ctrl::get_cycles(ppu);
+    });
+    g_android_perf.spu_threads = idm::select<named_thread<spu_thread>>([&](u32, named_thread<spu_thread>& spu)
+    {
+        g_android_perf.spu_cycles += thread_ctrl::get_cycles(spu);
+    });
+    g_android_perf.rsx_cycles += rsx->get_cycles();
+    const u64 total_cycles = std::max<u64>(1, g_android_perf.ppu_cycles + g_android_perf.spu_cycles + g_android_perf.rsx_cycles);
+    g_android_perf.host_cpu = static_cast<f32>(g_android_perf.cpu_stats.get_usage());
+    g_android_perf.ppu_cpu = std::clamp(g_android_perf.host_cpu * g_android_perf.ppu_cycles / total_cycles, 0.f, 100.f);
+    g_android_perf.spu_cpu = std::clamp(g_android_perf.host_cpu * g_android_perf.spu_cycles / total_cycles, 0.f, 100.f);
+    g_android_perf.rsx_cpu = std::clamp(g_android_perf.host_cpu * g_android_perf.rsx_cycles / total_cycles, 0.f, 100.f);
+    g_android_perf.rsx_load = rsx->get_load();
+    g_android_perf.sample_ready = g_android_perf.last_timestamp_us != 0 && g_android_perf.frametime_ms > 0.f;
+    android_perf_log_crosscheck_locked(now);
+    return android_perf_snapshot_json().dump();
+}
