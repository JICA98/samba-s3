+class ProgressReporter {
+public:
+  virtual ~ProgressReporter() = default;
+  virtual bool report(long value, long max, const std::string& message) = 0;
+};
+
+class StagedGameInstaller {
+public:
+  enum class InjectPoint {
+    None,
+    AfterStagingCreate,
+    DuringExtract,
+    BeforeCommit,
+    AfterBackupRename,
+    AfterStagingRename,
+  };
+  enum class TransactionPhase {
+    Prepared,
+    BackupMoved,
+    NewTitleMoved,
+  };
+
+  StagedGameInstaller(std::string configDir, std::string titleId,
+                      IsoInstallManifest manifest);
+  ~StagedGameInstaller();
+
+  StagedGameInstaller(const StagedGameInstaller&) = delete;
+  StagedGameInstaller& operator=(const StagedGameInstaller&) = delete;
+
+  const std::string& stagingPath() const { return m_stagingPath; }
+  const std::string& finalPath() const { return m_finalPath; }
+  const std::string& backupPath() const { return m_backupPath; }
+  const std::string& markerPath() const { return m_markerPath; }
+
+  std::optional<std::string> prepare();
+  std::optional<std::string> extract(iso_dev& iso, ProgressReporter& reporter);
+  std::optional<std::string> verify(ProgressReporter* reporter = nullptr);
+  std::optional<std::string> commit(ProgressReporter* reporter = nullptr);
+  std::optional<std::string> install(iso_dev& iso, ProgressReporter& reporter);
+
+  void cleanupStaging();
+  bool finalExists() const;
+  void setInjectFailure(InjectPoint point) { m_injectPoint = point; }
+
+  static std::optional<std::string> recoverStaleTransactions(
+      const std::string& configDir);
+
+private:
+  std::string m_configDir;
+  std::string m_titleId;
+  std::string m_token;
+  std::string m_gamesRoot;
+  std::string m_stagingRoot;
+  std::string m_backupRoot;
+  std::string m_transactionRoot;
+  std::string m_finalPath;
+  std::string m_stagingPath;
+  std::string m_backupPath;
+  std::string m_markerPath;
+  IsoInstallManifest m_manifest;
+  InjectPoint m_injectPoint = InjectPoint::None;
+  bool m_prepared = false;
+  bool m_committed = false;
+  bool m_backupMoved = false;
+  bool m_newTitleMoved = false;
+
+  bool shouldInject(InjectPoint point) const { return m_injectPoint == point; }
+  std::optional<std::string> writeMarker(TransactionPhase phase);
+  bool removeMarker();
+  bool restoreBackup();
+};
+
+bool isValidTitleIdForPath(std::string_view titleId);
+} // namespace rpcsx::android
