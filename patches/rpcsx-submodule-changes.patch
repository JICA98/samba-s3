+// Recovery boot for a savestate created by Android.  A savestate stores the
+// disc title ID, but a fresh process may not have that title in games.yml's
+// in-memory map yet.  Register the durable original game directory before
+// opening the archive so Load() can resolve /dev_bdvd after process death.
+extern "C" int _rpcsx_bootSavestate(std::string_view savestate_path_,
+                                    std::string_view original_game_path_) {
+  std::unique_lock lifecycleLock(g_emulator_lifecycle_mutex);
+
+  const std::string original_game_path(original_game_path_);
+  if (!original_game_path.empty()) {
+    const auto registration = Emu.AddGame(original_game_path);
+    rpcsx_android.notice("S3SAVE recovery-register-game path='%s' result=%d",
+                         original_game_path.c_str(), static_cast<int>(registration));
+  }
+
+  Emu.SetContinuousMode(true);
+  Emu.SetForceBoot(true);
+  const std::string savestate_path(savestate_path_);
+  const auto result = Emu.BootGame(savestate_path, "", true, cfg_mode::global);
+  rpcsx_android.notice("S3SAVE recovery-boot path='%s' result=%d",
+                       savestate_path.c_str(), static_cast<int>(result));
+  return static_cast<int>(result);
+}
