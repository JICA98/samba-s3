+static bool set_title_setting(std::string_view title_id,
+                              std::string_view path,
+                              std::string_view value_string) {
+  if (!valid_settings_title_id(title_id) || path.empty()) return false;
+
+  // Compose callers use @@-prefixed paths while sparse YAML maps use the
+  // canonical root-relative form. Normalize before touching the map so the
+  // in-memory candidate and disk readback compare identically.
+  const std::string normalized_path = normalize_settings_path(path);
+
+  cfg_root global;
+  if (!load_settings_root(global, global_settings_path())) return false;
+  auto* schema_node = find_cfg_node(&global, normalized_path);
+  if (!schema_node || schema_node->get_type() == cfg::type::node) return false;
+  const std::string global_encoded = encoded_cfg_value(schema_node);
+
+  sparse_settings_map values = load_sparse_title_settings(title_id, global);
+  if (value_string.empty()) {
+    values.erase(normalized_path);
+  } else {
+    nlohmann::json value;
+    try {
+      value = nlohmann::json::parse(value_string);
+    } catch (...) {
+      return false;
