+extern "C" std::string _rpcsx_getCurrentTrophies()
+{
+    std::string trophy_set;
+    try
+    {
+        if (auto* current = g_fxo->try_get<current_trophy_name>())
+        {
+            std::lock_guard lock(current->mtx);
+            trophy_set = current->name;
+        }
+    }
+    catch (...) {}
+    const std::string title_id = Emu.GetTitleID();
+    if (!trophy_set.empty()) return android_get_trophies_for_set(std::move(trophy_set), title_id, "live");
+    return _rpcsx_getTrophiesForTitle(title_id.c_str());
+}
+
+extern "C" std::string _rpcsx_getTrophiesForTitle(const char* requested_title_id)
+{
+    const std::string title_id = requested_title_id ? requested_title_id : "";
+    nlohmann::json unavailable{{"available", false}, {"status", "no_trophy_set"},
+                               {"titleId", title_id}, {"trophies", nlohmann::json::array()}};
+    if (title_id.empty()) return unavailable.dump();
+    try
+    {
+        const std::string root = rpcs3::utils::get_hdd0_dir() + "home/" + Emu.GetUsr() + "/trophy/";
+        for (const auto& entry : fs::dir(root))
+        {
+            if (!entry.is_directory || entry.name == "." || entry.name == "..") continue;
+            const std::string config_path = root + entry.name + "/TROPCONF.SFM";
+            fs::file config(config_path);
+            if (!config) continue;
+            trophy_xml_document document;
+            if (!document.Read(config.to_string())) continue;
+            auto xml_root = document.GetRoot();
+            if (!xml_root) continue;
+            bool matches = false;
+            for (std::shared_ptr<rXmlNode> node = xml_root->GetChildren(); node; node = node->GetNext())
+            {
+                if (node->GetName() == "title-id" && node->GetNodeContent() == title_id)
+                {
+                    matches = true;
+                    break;
+                }
+            }
+            if (!matches)
+            {
+                const std::string disc = rpcs3::utils::get_games_dir() + title_id + "/PS3_GAME/TROPDIR/" + entry.name + "/TROPHY.TRP";
+                const std::string installed = rpcs3::utils::get_hdd0_dir() + "game/" + title_id + "/TROPDIR/" + entry.name + "/TROPHY.TRP";
+                matches = fs::is_file(disc) || fs::is_file(installed);
+            }
+            if (matches) return android_get_trophies_for_set(entry.name, title_id, "title");
+        }
+    }
+    catch (const std::exception& e)
+    {
+        rpcsx_android.error("getTrophiesForTitle failed: %s", e.what());
+    }
+    catch (...) {}
+    return unavailable.dump();
+}
