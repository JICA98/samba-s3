+    if (!pair.first.IsScalar()) continue;
+    const std::string key = pair.first.Scalar();
+    const std::string path = base_path.empty() ? key : base_path + "@@" + key;
+    if (pair.second.IsMap()) {
+      collect_sparse_yaml(pair.second, path, schema, result);
+      continue;
+    }
+    if (!pair.second.IsScalar()) continue;
+    if (auto* node = find_cfg_node(&schema, path)) {
+      const std::string encoded = encoded_yaml_value(node, pair.second);
+      if (!encoded.empty()) result[path] = encoded;
+    }
+  }
 }
 
