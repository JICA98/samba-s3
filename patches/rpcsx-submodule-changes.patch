diff --git a/rpcs3/Emu/compile_progress.cpp b/rpcs3/Emu/compile_progress.cpp
new file mode 100644
index 000000000..dc7a56339
--- /dev/null
+++ b/rpcs3/Emu/compile_progress.cpp
@@ -0,0 +1,190 @@
+#include "stdafx.h"
+#include "compile_progress.hpp"
+#include "localized_string.h"
+#include "Emu/Cell/timers.hpp"
+#include "util/logs.hpp"
+#include "rx/asm.hpp"
+
+#include <mutex>
+#include <atomic>
+
+LOG_CHANNEL(sys_log, "SYS");
+
+// --- Event sink (thread-safe copy-then-invoke) ---
+static std::mutex g_compile_sink_mutex;
+static compile_event_sink_t g_compile_sink;
+static std::atomic<u64> g_next_job_id{1};
+
+void set_compile_event_sink(compile_event_sink_t sink)
+{
+    std::lock_guard<std::mutex> lock(g_compile_sink_mutex);
+    g_compile_sink = std::move(sink);
+}
+
+compile_event_sink_t get_compile_event_sink()
+{
+    std::lock_guard<std::mutex> lock(g_compile_sink_mutex);
+    return g_compile_sink;
+}
+
+void emit_compile_event(const CompileEvent& ev)
+{
+    compile_event_sink_t sink;
+    {
+        std::lock_guard<std::mutex> lock(g_compile_sink_mutex);
+        sink = g_compile_sink;
+    }
+    if (sink)
+    {
+        // Exceptions are disabled in the Android engine build.
+        sink(ev);
+    }
+}
+
+u64 allocate_compile_job_id()
+{
+    return g_next_job_id.fetch_add(1, std::memory_order_relaxed);
+}
+
+// --- System progress origin context ---
+static std::mutex g_ctx_mutex;
+static SystemProgressContext g_current_ctx{CompileOrigin::RUNTIME, 0, ""};
+static bool g_has_ctx = false;
+
+void set_system_progress_context(const SystemProgressContext& ctx)
+{
+    std::lock_guard<std::mutex> lock(g_ctx_mutex);
+    if (g_has_ctx && g_current_ctx.origin != ctx.origin)
+    {
+        sys_log.warning("set_system_progress_context: overriding existing context origin=%d with %d (jobId %llu->%llu)",
+            (int)g_current_ctx.origin, (int)ctx.origin, g_current_ctx.jobId, ctx.jobId);
+    }
+    g_current_ctx = ctx;
+    g_has_ctx = true;
+}
+
+SystemProgressContext get_system_progress_context()
+{
+    std::lock_guard<std::mutex> lock(g_ctx_mutex);
+    if (!g_has_ctx)
+        return SystemProgressContext{CompileOrigin::RUNTIME, 0, ""};
+    return g_current_ctx;
+}
+
+void clear_system_progress_context()
+{
+    std::lock_guard<std::mutex> lock(g_ctx_mutex);
+    g_current_ctx = SystemProgressContext{CompileOrigin::RUNTIME, 0, ""};
+    g_has_ctx = false;
+}
+
+// --- Snapshot builder ---
+// This mirrors the logic in system_progress.cpp:260-341 — compute progr, percent, ETA
+// with time_left_queue smoothing. Extracted so both RSX UI and Android bridge share
+// the exact same string and percentValue.
+
+PpuProgressSnapshot build_system_progress_snapshot(
+    u32 fdone, u32 ftotal,
+    u32 pdone, u32 ptotal,
+    u64 fknown_bits, u64 ftotal_bits,
+    const std::string& text1,
+    u64 start_time,
+    std::vector<std::pair<u64, u64>>& time_left_queue,
+    usz& time_left_queue_idx,
+    const std::string& /*base_progr_prefix*/)
+{
+    PpuProgressSnapshot snap;
+    snap.fileDone = static_cast<int>(fdone);
+    snap.fileTotal = static_cast<int>(ftotal);
+    snap.moduleDone = static_cast<int>(pdone);
+    snap.moduleTotal = static_cast<int>(ptotal);
+
+    // Compute progress in percents — same as original system_progress.cpp
+    const bool use_bits = fknown_bits && ftotal_bits;
+    const u64 known_files = use_bits ? fknown_bits : ftotal;
+    const u64 total = rx::rational_mul<u64>(std::max<u64>(ptotal, 1), std::max<u64>(use_bits ? ftotal_bits : ftotal, 1), std::max<u64>(known_files, 1));
+    const u64 done = pdone;
+    const u32 value = static_cast<u32>(done >= total ? 100 : done * 100 / total);
+    snap.percentValue = static_cast<int>(value);
+    snap.percentMax = 100;
+
+    std::string progr;
+    if (ftotal || ptotal)
+    {
+        progr = get_localized_string(localized_string_id::PROGRESS_DIALOG_PROGRESS);
+        if (ftotal)
+            fmt::append(progr, " %s %u %s %u%s", get_localized_string(localized_string_id::PROGRESS_DIALOG_FILE), fdone, get_localized_string(localized_string_id::PROGRESS_DIALOG_OF), ftotal, ptotal ? "," : "");
+        if (ptotal)
+            fmt::append(progr, " %s %u %s %u", get_localized_string(localized_string_id::PROGRESS_DIALOG_MODULE), pdone, get_localized_string(localized_string_id::PROGRESS_DIALOG_OF), ptotal);
+
+        const u32 of_1000 = static_cast<u32>(done >= total ? 1000 : done * 1000 / total);
+        if (of_1000 >= 2)
+        {
+            const u64 passed = (get_system_time() - start_time);
+            const u64 total_t = rx::rational_mul<u64>(passed, 1000, of_1000);
+            const u64 remaining = total_t - passed;
+
+            u64 max_remaining = remaining;
+            for (usz i = 0; i < time_left_queue.size(); i++)
+            {
+                const auto& sample = time_left_queue[(time_left_queue.size() + time_left_queue_idx - i) % time_left_queue.size()];
+                const u64 sample_age = passed - sample.first;
+                if (passed - sample.first >= 4'000'000)
+                    break;
+                max_remaining = std::max<u64>(max_remaining, sample.second >= sample_age ? sample.second - sample_age : 0);
+            }
+
+            if (auto new_val = std::make_pair(passed, remaining); time_left_queue[time_left_queue_idx] != new_val)
+            {
+                time_left_queue_idx = (time_left_queue_idx + 1) % time_left_queue.size();
+                time_left_queue[time_left_queue_idx] = new_val;
+            }
+
+            const u64 max_seconds_remaining = max_remaining / 1'000'000;
+            const u64 seconds = max_seconds_remaining % 60;
+            const u64 minutes = (max_seconds_remaining / 60) % 60;
+            const u64 hours = (max_seconds_remaining / 3600);
+
+            if (passed < 4'000'000)
+            {
+            }
+            else if (done >= total)
+            {
+                fmt::append(progr, " (%s)", get_localized_string(localized_string_id::PROGRESS_DIALOG_DONE));
+            }
+            else if (hours)
+            {
+                fmt::append(progr, " (%uh %2um %s)", hours, minutes, get_localized_string(localized_string_id::PROGRESS_DIALOG_REMAINING));
+            }
+            else if (minutes >= 2)
+            {
+                fmt::append(progr, " (%um %s)", minutes, get_localized_string(localized_string_id::PROGRESS_DIALOG_REMAINING));
+            }
+            else if (minutes == 0)
+            {
+                fmt::append(progr, " (%us %s)", std::max<u64>(seconds, 1), get_localized_string(localized_string_id::PROGRESS_DIALOG_REMAINING));
+            }
+            else
+            {
+                fmt::append(progr, " (%um %2us %s)", minutes, seconds, get_localized_string(localized_string_id::PROGRESS_DIALOG_REMAINING));
+            }
+        }
+    }
+    else
+    {
+        progr = get_localized_string(localized_string_id::PROGRESS_DIALOG_PROGRESS_ANALYZING);
+    }
+
+    snap.message = std::move(progr);
+    return snap;
+}
+
+// For tests / callers that don't have state unpacked yet — placeholder
+PpuProgressSnapshot build_system_progress_snapshot_from_state(
+    const std::string& /*text1*/,
+    u64 /*start_time*/,
+    std::vector<std::pair<u64, u64>>& /*time_left_queue*/,
+    usz& /*time_left_queue_idx*/)
+{
+    return PpuProgressSnapshot{};
+}
diff --git a/rpcs3/Emu/compile_progress.hpp b/rpcs3/Emu/compile_progress.hpp
new file mode 100644
index 000000000..e49170ba4
--- /dev/null
+++ b/rpcs3/Emu/compile_progress.hpp
@@ -0,0 +1,93 @@
+#pragma once
+
+#include "util/types.hpp"
+
+#include <functional>
+#include <optional>
+#include <string>
+
+enum class CompileDomain : int
+{
+    PPU = 0,
+    SHADER = 1,
+};
+
+enum class CompilePhase : int
+{
+    BEGIN = 0,
+    PROGRESS = 1,
+    COMPLETED = 2,
+    FAILED = 3,
+    CANCELED = 4,
+};
+
+enum class CompileOrigin : int
+{
+    INSTALL = 0,
+    RUNTIME = 1,
+};
+
+struct PpuProgressSnapshot
+{
+    int percentValue = 0; // 0..100 — same value driving the RSX progress bar
+    int percentMax = 100;
+    std::string message; // verbatim progr — e.g. "Progress: file 21 of 78, module 24 of 33 (10m remaining)"
+    int fileDone = 0;
+    int fileTotal = 0;
+    int moduleDone = 0;
+    int moduleTotal = 0;
+};
+
+struct CompileEvent
+{
+    CompileDomain domain;
+    CompilePhase phase;
+    CompileOrigin origin;
+    u64 jobId = 0; // stable per PPU session or pipeline job
+    std::string titleId; // associated titleId for per-game UI binding
+    std::optional<PpuProgressSnapshot> ppu;
+};
+
+// Global event sink — platform neutral, thread-safe copy-then-invoke
+using compile_event_sink_t = std::function<void(const CompileEvent&)>;
+
+void set_compile_event_sink(compile_event_sink_t sink);
+compile_event_sink_t get_compile_event_sink();
+void emit_compile_event(const CompileEvent& ev);
+u64 allocate_compile_job_id();
+
+// System-progress origin context (install vs runtime). Process-wide, mutex protected
+// because CompilationQueue and progress_dialog_server run on different threads.
+// Default origin is RUNTIME. CompilationQueue::impl sets INSTALL immediately before
+// ppu_precompile and clears it after.
+struct SystemProgressContext
+{
+    CompileOrigin origin = CompileOrigin::RUNTIME;
+    u64 jobId = 0;
+    std::string titleId; // associated title for install jobs; empty => Emu.GetTitleID() fallback
+};
+
+void set_system_progress_context(const SystemProgressContext& ctx);
+SystemProgressContext get_system_progress_context();
+void clear_system_progress_context();
+
+// Helper that computes PpuProgressSnapshot exactly once, preserving time_left_queue
+// smoothing state. Both the RSX UI and the Android bridge consume the same snapshot.
+// Must be called before the show_overlay_message early-continue so the Android path
+// still receives the update.
+PpuProgressSnapshot build_system_progress_snapshot(
+    u32 fdone, u32 ftotal,
+    u32 pdone, u32 ptotal,
+    u64 fknown_bits, u64 ftotal_bits,
+    const std::string& text1,
+    u64 start_time,
+    std::vector<std::pair<u64, u64>>& time_left_queue,
+    usz& time_left_queue_idx,
+    const std::string& base_progr_prefix);
+
+// Convenience that builds snapshot with current g_progr_* state. Exposed for testing.
+PpuProgressSnapshot build_system_progress_snapshot_from_state(
+    const std::string& text1,
+    u64 start_time,
+    std::vector<std::pair<u64, u64>>& time_left_queue,
+    usz& time_left_queue_idx);
