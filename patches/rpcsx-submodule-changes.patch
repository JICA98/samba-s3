+extern "C" void _rpcsx_android_perf_frame_presented(u64 timestamp_us)
+{
+    if (!g_android_perf_frame_sampling_enabled.load(std::memory_order_relaxed))
+        return;
+
+    std::lock_guard lock(g_android_perf.mutex);
+    if (!g_android_perf.enabled)
+        return;
+
+    if (g_android_perf.last_present_timestamp_us != 0 && timestamp_us > g_android_perf.last_present_timestamp_us)
+    {
+        const f32 frame_time_ms = static_cast<f32>(timestamp_us - g_android_perf.last_present_timestamp_us) / 1000.f;
+        g_android_perf.frametime_samples.push_back({timestamp_us, frame_time_ms});
+        g_android_perf.pending_frametime_samples.push_back({timestamp_us, frame_time_ms});
+        while (g_android_perf.frametime_samples.size() > 240)
+            g_android_perf.frametime_samples.pop_front();
+    }
+
+    g_android_perf.last_present_timestamp_us = timestamp_us;
+    ++g_android_perf.presented_frame_count;
+}
