+extern "C" const char* _rpcsx_compileInstallPpuBatch(
+    const char* title_id,
+    const char* game_path,
+    u64 logical_job_id,
+    u32 max_new_objects) {
+  ProcessMemStats start_mem = read_process_mem_stats();
+
+  if (!game_path || !*game_path) {
+    g_compile_batch_result_json = build_batch_result_json(
+        "failed", 0, 0, 0, 0, start_mem, start_mem, "invalid_game_path");
+    return g_compile_batch_result_json.c_str();
+  }
+
+  std::unique_lock lifecycle_lock(g_emulator_lifecycle_mutex, std::try_to_lock);
+  if (!lifecycle_lock.owns_lock()) {
+    g_compile_batch_result_json = build_batch_result_json(
+        "busy", 0, 0, 0, 0, start_mem, start_mem, "lifecycle_mutex_busy");
+    return g_compile_batch_result_json.c_str();
+  }
+
+  if (!Emu.IsStopped(true)) {
+    g_compile_batch_result_json = build_batch_result_json(
+        "busy", 0, 0, 0, 0, start_mem, start_mem, "emulator_not_stopped");
+    return g_compile_batch_result_json.c_str();
+  }
+
+  g_install_batch_canceled.store(false, std::memory_order_release);
+
+  std::string compileRoot = Emu.ResolvePpuCompileRoot(game_path);
+  std::string ebootPath;
+  std::string rootPathStr;
+  if (!compileRoot.empty()) {
+    rootPathStr = compileRoot;
+    if (Emu.GetElfPathFromDir(ebootPath, compileRoot) != game_boot_result::no_errors) {
+      ebootPath.clear();
+    }
+  }
+  if (ebootPath.empty()) {
+    ebootPath = locateEbootPath(game_path);
+    if (ebootPath.empty() && std::filesystem::is_regular_file(game_path)) {
+      ebootPath = game_path;
+    }
+  }
+  if (ebootPath.empty() || !fs::is_file(ebootPath)) {
+    g_compile_batch_result_json = build_batch_result_json(
+        "failed", 0, 0, 0, 0, start_mem, start_mem, "missing_eboot_file");
+    return g_compile_batch_result_json.c_str();
+  }
+
+  auto rootPath = std::filesystem::path(rootPathStr.empty() ? ebootPath : rootPathStr);
+  if (rootPathStr.empty()) {
+    if (rootPath.filename() == "USRDIR") {
+      rootPath = rootPath.parent_path();
+    } else if (!std::filesystem::is_directory(rootPath)) {
+      rootPath = rootPath.parent_path();
+      if (rootPath.filename() == "USRDIR") {
+        rootPath = rootPath.parent_path();
+      }
+    }
+    rootPathStr = rootPath.string();
+  }
+
+  std::string title;
+  if (title_id && *title_id) {
+    title = title_id;
+  } else {
+    auto sfo = locateParamSfoPath(rootPathStr.empty() ? rootPath.string() : rootPathStr);
+    if (sfo.empty()) {
+      const std::string root = rootPathStr.empty() ? rootPath.string() : rootPathStr;
+      const std::string a = root + (root.ends_with("/") ? "PS3_GAME/PARAM.SFO" : "/PS3_GAME/PARAM.SFO");
+      const std::string b = root + (root.ends_with("/") ? "PARAM.SFO" : "/PARAM.SFO");
+      if (fs::is_file(a)) sfo = a;
+      else if (fs::is_file(b)) sfo = b;
+    }
+    if (!sfo.empty()) {
+      const auto psf = psf::load_object(sfo);
+      title = std::string(psf::get_string(psf, "TITLE_ID"));
+    }
+  }
+  if (title.empty()) {
+    title = Emu.GetTitleID();
+  }
+  if (title.empty()) {
+    title = "UNKNOWN";
+  }
+  Emu.SetTitleID(title);
+
+  ScopedPpuTitleConfig title_config(title);
+  if (!title_config.valid) {
+    g_compile_batch_result_json = build_batch_result_json(
+        "failed", 0, 0, 0, 0, start_mem, start_mem, "title_config_invalid");
+    return g_compile_batch_result_json.c_str();
+  }
+
+  const u32 step_max = max_new_objects > 0 ? max_new_objects : 16;
+  SystemProgressContext context{CompileOrigin::INSTALL, logical_job_id, title, step_max};
+  set_system_progress_context(context);
+  reset_ppu_install_batch_stats();
+  set_ppu_install_step_more_work(false);
+
+  struct BatchContextGuard {
+    ~BatchContextGuard() { clear_system_progress_context(); }
+  } batch_guard;
+
+  g_fxo->init<named_thread<progress_dialog_server>>();
+  g_fxo->init<main_ppu_module<lv2_obj>>();
+  g_fxo->init(false, nullptr);
+  Emu.SetState(system_state::running);
+
+  auto &_main = *ensure(g_fxo->try_get<main_ppu_module<lv2_obj>>());
+
+  fs::file src{ebootPath};
+  src = decrypt_self(src);
+  const ppu_exec_object obj = src;
+  if (obj != elf_error::ok || !ppu_load_exec(obj, true, ebootPath)) {
+    g_fxo->reset();
+    Emu.SetState(system_state::stopped);
+    auto end_mem = read_process_mem_stats();
+    g_compile_batch_result_json = build_batch_result_json(
+        "failed", 0, 0, 0, 0, start_mem, end_mem, "failed_to_load_executable");
+    return g_compile_batch_result_json.c_str();
+  }
+  _main.path = ebootPath;
+
+  std::vector<std::string> dir_queue;
+  collect_fs_directories(rootPathStr.empty() ? rootPath.string() : rootPathStr, dir_queue);
+
+  std::vector<ppu_module<lv2_obj> *> mod_list;
+  bool more_work = false;
+
+  if (_main.analyse(0, _main.elf_entry, _main.seg0_code_end,
+                    _main.applied_patches, std::vector<u32>{},
+                    []() { return g_install_batch_canceled.load(); })) {
+    Emu.ConfigurePPUCache();
+    Emu.SetTestMode();
+
+    set_ppu_install_step_more_work(false);
+    ppu_initialize(_main);
+    more_work = get_ppu_install_step_more_work();
+    ppu_finalize(_main, true);
+    mod_list.emplace_back(&_main);
+  } else {
+    g_fxo->reset();
+    Emu.SetState(system_state::stopped);
+    auto end_mem = read_process_mem_stats();
+    const bool was_canceled = g_install_batch_canceled.load();
+    g_compile_batch_result_json = build_batch_result_json(
+        was_canceled ? "canceled" : "failed", 0, 0, 0, 0, start_mem, end_mem,
+        was_canceled ? "canceled_during_analyse" : "failed_to_analyse_executable");
+    return g_compile_batch_result_json.c_str();
+  }
+
+  if (!more_work && !g_install_batch_canceled.load()) {
+    ppu_precompile(dir_queue, mod_list.empty() ? nullptr : &mod_list);
+    more_work = get_ppu_install_step_more_work();
+  }
+
+  g_fxo->reset();
+  Emu.SetState(system_state::stopped);
+
+  auto stats = get_ppu_install_batch_stats();
+  auto end_mem = read_process_mem_stats();
+
+  std::string status = "all_complete";
+  if (g_install_batch_canceled.load()) {
+    status = "canceled";
+  } else if (more_work || stats.remaining_uncached > 0) {
+    status = "more_work";
+  }
+
+  __android_log_print(
+      ANDROID_LOG_INFO, "S3PPUBATCH",
+      "compile_batch_terminal status=%s title=%s total=%u cached_before=%u compiled=%u cached_after=%u "
+      "vm_start=%llu vm_end=%llu rss=%llu maps=%llu",
+      status.c_str(), title.c_str(), stats.total_modules, stats.cached_before, stats.compiled_this_batch,
+      stats.cached_after, (unsigned long long)start_mem.vm_size_kb, (unsigned long long)end_mem.vm_size_kb,
+      (unsigned long long)end_mem.vm_rss_kb, (unsigned long long)end_mem.map_count);
+
+  g_compile_batch_result_json = build_batch_result_json(
+      status, stats.total_modules, stats.cached_before, stats.cached_after, stats.compiled_this_batch,
+      start_mem, end_mem, status, stats.enqueued, stats.remaining_uncached);
+  return g_compile_batch_result_json.c_str();
+}
+
+extern "C" const char* _rpcsx_compileRuntimePpuBatch(
+    const char* title_id,
+    const char* game_path,
+    u64 logical_job_id,
+    u32 max_new_objects)
+{
+  const ProcessMemStats start_mem = read_process_mem_stats();
+
+  if (!game_path || !*game_path) {
+    g_compile_batch_result_json = build_batch_result_json(
+        "failed", 0, 0, 0, 0, start_mem, start_mem, "invalid_game_path");
+    return g_compile_batch_result_json.c_str();
+  }
+
+  std::unique_lock lifecycle_lock(g_emulator_lifecycle_mutex, std::try_to_lock);
+  if (!lifecycle_lock.owns_lock()) {
+    g_compile_batch_result_json = build_batch_result_json(
+        "busy", 0, 0, 0, 0, start_mem, start_mem, "lifecycle_mutex_busy");
+    return g_compile_batch_result_json.c_str();
+  }
+  if (!Emu.IsStopped(true)) {
+    g_compile_batch_result_json = build_batch_result_json(
+        "busy", 0, 0, 0, 0, start_mem, start_mem, "emulator_not_stopped");
+    return g_compile_batch_result_json.c_str();
+  }
+
+  const std::string title = title_id && *title_id ? title_id : "UNKNOWN";
+  ScopedPpuTitleConfig title_config(title);
+  if (!title_config.valid) {
+    g_compile_batch_result_json = build_batch_result_json(
+        "failed", 0, 0, 0, 0, start_mem, start_mem, "title_config_invalid");
+    return g_compile_batch_result_json.c_str();
+  }
+  const u64 job_id = logical_job_id != 0 ? logical_job_id : allocate_compile_job_id();
+  const u32 step_max = max_new_objects > 0 ? max_new_objects : 16;
+
+  g_install_batch_canceled.store(false, std::memory_order_release);
+  g_prelaunch_session.store(job_id, std::memory_order_release);
+  g_prelaunch_canceled.store(false, std::memory_order_release);
+  set_system_progress_context(SystemProgressContext{CompileOrigin::PRELAUNCH, job_id, title, step_max});
+  reset_ppu_install_batch_stats();
+  set_ppu_install_step_more_work(false);
+
+  struct RuntimeBatchContextGuard {
+    ~RuntimeBatchContextGuard() {
+      clear_system_progress_context();
+      g_prelaunch_canceled.store(false, std::memory_order_release);
+    }
+  } context_guard;
+
+  __android_log_print(
+      ANDROID_LOG_INFO, "S3PPUBATCH",
+      "runtime_batch_begin title=%s job=%llu max_new=%u path=%s",
+      title.c_str(), static_cast<unsigned long long>(job_id), step_max, game_path);
+
+  const auto result = Emu.PreparePpuOnly(
+      game_path,
+      title,
+      [job_id]() {
+        return g_install_batch_canceled.load(std::memory_order_acquire) ||
+            (g_prelaunch_session.load(std::memory_order_acquire) == job_id &&
+             g_prelaunch_canceled.load(std::memory_order_acquire));
+      });
+
+  const bool more_work = get_ppu_install_step_more_work();
+  const auto stats = get_ppu_install_batch_stats();
+  const ProcessMemStats end_mem = read_process_mem_stats();
+  const bool canceled = g_install_batch_canceled.load(std::memory_order_acquire) ||
+      result == Emulator::ppu_preflight_result::canceled;
+
+  std::string status;
+  if (canceled) {
+    status = "canceled";
+  } else if (result != Emulator::ppu_preflight_result::success || !Emu.IsStopped(true)) {
+    status = "failed";
+  } else if (more_work || stats.remaining_uncached > 0) {
+    status = "more_work";
+  } else {
+    status = "all_complete";
+  }
+
+  __android_log_print(
