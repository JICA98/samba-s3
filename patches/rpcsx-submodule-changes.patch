new file mode 100644
index 000000000..00a3f8aa5
--- /dev/null
+++ b/android/src/atomic-file-copier.cpp
@@ -0,0 +1,117 @@
+#include "atomic-file-copier.hpp"
+
+#include "util/StrFmt.h"
+
+#include <algorithm>
+#include <vector>
+
+namespace rpcsx::android {
+namespace {
+constexpr u64 kCopyBufferSize = 8 * 1024 * 1024;
+thread_local CopyTestHooks g_testHooks;
+} // namespace
+
+void setCopyTestHooks(CopyTestHooks hooks) { g_testHooks = std::move(hooks); }
+void clearCopyTestHooks() { g_testHooks = CopyTestHooks{}; }
+
+AtomicFileCopyResult copyFileAtomically(fs::file &source,
+                                        const std::string &destination,
+                                        u64 expectedSize) {
+  AtomicFileCopyResult result;
+
+  if (source.seek(0, fs::seek_set) != 0) {
+    result.error = fmt::format("Failed to rewind source for %s", destination);
+    return result;
+  }
+
+  if (source.size() != expectedSize) {
+    result.error =
+        fmt::format("Source size mismatch for %s: expected %llu, got %llu",
+                    destination, expectedSize, source.size());
+    return result;
+  }
+
+  fs::pending_file pending(destination);
+  if (!pending.file) {
+    result.error =
+        fmt::format("Failed to create pending file for %s", destination);
+    return result;
+  }
+
+  // Zero-byte files are valid; no buffer needed and no read/write
+  if (expectedSize == 0) {
+    if (pending.file.size() != 0) {
+      result.error = fmt::format("Final size mismatch for %s: expected 0, wrote %llu", destination, pending.file.size());
+      return result;
+    }
+    if (g_testHooks.onCommit && !g_testHooks.onCommit(destination)) {
+      result.error = fmt::format("Injected commit failure for %s", destination);
+      return result;
+    }
+    if (!pending.commit()) {
+      result.error = fmt::format("Failed to commit completed file %s", destination);
+    }
+    return result;
+  }
+
+  std::vector<u8> buffer(
+      static_cast<std::size_t>(std::min(expectedSize, kCopyBufferSize)));
+  if (buffer.empty()) {
+    buffer.resize(4096);
+  }
+
+  while (result.bytesCopied < expectedSize) {
+    const u64 requested =
+        std::min<u64>(buffer.size(), expectedSize - result.bytesCopied);
+    u64 bytesRead = source.read(buffer.data(), requested);
+    if (g_testHooks.onRead) {
+      u64 injected = bytesRead;
+      if (!g_testHooks.onRead(result.bytesCopied, requested, injected)) {
+        bytesRead = injected; // allow hook to modify bytesRead to simulate short read
+      }
+    }
+    if (bytesRead != requested) {
+      result.error =
+          fmt::format("Incomplete read for %s: expected %llu, read %llu",
+                      destination, expectedSize,
+                      result.bytesCopied + bytesRead);
+      return result;
+    }
+
+    u64 bytesWritten = pending.file.write(buffer.data(), bytesRead);
+    if (g_testHooks.onWrite) {
+      u64 injected = bytesWritten;
+      if (!g_testHooks.onWrite(result.bytesCopied, bytesRead, injected)) {
+        bytesWritten = injected;
+      }
+    }
+    result.bytesCopied += bytesWritten;
+    if (bytesWritten != bytesRead) {
+      result.error =
+          fmt::format("Incomplete write for %s: expected %llu, wrote %llu",
+                      destination, expectedSize, result.bytesCopied);
+      return result;
+    }
+  }
+
+  const u64 finalSize = pending.file.size();
+  if (finalSize != expectedSize) {
+    result.error =
+        fmt::format("Final size mismatch for %s: expected %llu, wrote %llu",
+                    destination, expectedSize, finalSize);
+    return result;
+  }
+
+  if (g_testHooks.onCommit && !g_testHooks.onCommit(destination)) {
+    result.error = fmt::format("Injected commit failure for %s", destination);
+    return result;
+  }
+
+  if (!pending.commit()) {
+    result.error =
+        fmt::format("Failed to commit completed file %s", destination);
+  }
+
+  return result;
+}
+} // namespace rpcsx::android
