+extern "C" std::string _rpcsx_getCurrentTrophies()
+{
+    std::string tropName;
+    try {
+        if (auto* cur = g_fxo->try_get<current_trophy_name>()) {
+            std::lock_guard lock(cur->mtx);
+            tropName = cur->name;
+        }
+    } catch (...) {}
+    const std::string title_id = Emu.GetTitleID();
+    if (!tropName.empty()) return android_get_trophies_for_set(std::move(tropName), title_id, "live");
+
+    // Disc-backed games can expose the trophy set through Emu.GetDir() before
+    // current_trophy_name is populated. Read the actual mounted TROPDIR.
+    try {
+        const std::string trophy_root = rpcs3::utils::get_games_dir() + title_id + "/PS3_GAME/TROPDIR/";
+        for (const auto& entry : fs::dir(trophy_root)) {
+            if (entry.is_directory && entry.name != "." && entry.name != "..")
+                return android_get_trophies_for_set(entry.name, title_id, "live");
+        }
+    } catch (...) {}
+
+    // Some titles only publish the trophy set name through the runtime after
+    // sceNpTrophy has initialized. Resolve the current title through the
+    // installed/disc TROPDIR as a real fallback instead of exposing a
+    // permanently "initializing" page.
+    return _rpcsx_getTrophiesForTitle(title_id.c_str());
+}
+
+extern "C" std::string _rpcsx_getTrophiesForTitle(const char* requested_title_id)
+{
+    const std::string title_id = requested_title_id ? requested_title_id : "";
+    nlohmann::json unavailable{
+        {"available", false}, {"status", "no_trophy_set"}, {"titleId", title_id},
+        {"trophies", nlohmann::json::array()}
+    };
+    if (title_id.empty()) return unavailable.dump();
+
+    try {
+        const std::string root = rpcs3::utils::get_hdd0_dir() + "home/" + Emu.GetUsr() + "/trophy/";
+        for (const auto& entry : fs::dir(root)) {
+            if (!entry.is_directory || entry.name == "." || entry.name == "..") continue;
+            const std::string trophy_set = entry.name;
+            const std::string conf_path = root + trophy_set + "/TROPCONF.SFM";
+            fs::file config(conf_path);
+            if (!config) continue;
+
+            trophy_xml_document document;
+            if (!document.Read(config.to_string())) continue;
+            auto xml_root = document.GetRoot();
+            if (!xml_root) continue;
+            bool matches = false;
+            for (std::shared_ptr<rXmlNode> node = xml_root->GetChildren(); node; node = node->GetNext()) {
+                if (node->GetName() == "title-id" && node->GetNodeContent() == title_id) {
+                    matches = true;
+                    break;
+                }
+            }
+            if (!matches) {
+                const std::string disc_path = rpcs3::utils::get_games_dir() + title_id + "/PS3_GAME/TROPDIR/" + trophy_set + "/TROPHY.TRP";
+                const std::string installed_path = rpcs3::utils::get_hdd0_dir() + "game/" + title_id + "/TROPDIR/" + trophy_set + "/TROPHY.TRP";
+                matches = fs::is_file(disc_path) || fs::is_file(installed_path);
+            }
+            if (matches) return android_get_trophies_for_set(trophy_set, title_id, "title");
+        }
+    } catch (const std::exception& e) {
+        rpcsx_android.error("getTrophiesForTitle failed: %s", e.what());
+    } catch (...) {}
+    return unavailable.dump();
+}
