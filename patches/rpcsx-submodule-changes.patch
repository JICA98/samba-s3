+static void android_prepare_trp_language(TRPLoader& trp)
+{
+    const usz kTargetBufferLength = 31;
+    char target[kTargetBufferLength + 1]{};
+    strcpy_trunc(target, fmt::format("TROP_%02d.SFM", static_cast<s32>(g_cfg.sys.language)));
+    if (trp.ContainsEntry(target))
+    {
+        trp.RemoveEntry("TROPCONF.SFM");
+        trp.RemoveEntry("TROP.SFM");
+        trp.RenameEntry(target, "TROPCONF.SFM");
+    }
+    else if (trp.ContainsEntry("TROP.SFM"))
+    {
+        trp.RemoveEntry("TROPCONF.SFM");
+        trp.RenameEntry("TROP.SFM", "TROPCONF.SFM");
+    }
+    for (s32 i = 0; i <= 18; i++)
+    {
+        strcpy_trunc(target, fmt::format("TROP_%02d.SFM", i));
+        if (i != static_cast<s32>(g_cfg.sys.language))
+        {
+            trp.RemoveEntry(target);
+        }
+    }
+}
+
+static bool android_install_trophy_set_from_trp(fs::file& trp_stream, const std::string& set_name, const std::string& title_id)
+{
+    if (!trp_stream || set_name.empty() || set_name == "." || set_name == "..") return false;
+    TRPLoader trp(trp_stream);
+    if (!trp.LoadHeader()) return false;
+    if (!trp.ContainsEntry("TROPCONF.SFM") && !trp.ContainsEntry("TROP.SFM"))
+    {
+        const usz kTargetBufferLength = 31;
+        char target[kTargetBufferLength + 1]{};
+        strcpy_trunc(target, fmt::format("TROP_%02d.SFM", static_cast<s32>(g_cfg.sys.language)));
+        if (!trp.ContainsEntry(target)) return false;
+    }
+    android_prepare_trp_language(trp);
+    if (!trp.ContainsEntry("TROPCONF.SFM")) return false;
+
+    const std::string usr = Emu.GetUsr();
+    if (usr.empty()) return false;
+    fs::create_path(rpcs3::utils::get_hdd0_dir() + "home/" + usr + "/trophy");
+    const std::string vfs_trophy = "/dev_hdd0/home/" + usr + "/trophy/" + set_name;
+    if (!trp.Install(vfs_trophy))
+    {
+        rpcsx_android.error("ISO trophy install failed set=%s title=%s err=%s", set_name, title_id, fs::g_tls_error);
+        return false;
+    }
+    TROPUSRLoader tropusr;
+    if (!tropusr.Load(vfs_trophy + "/TROPUSR.DAT", vfs_trophy + "/TROPCONF.SFM").success)
+    {
+        rpcsx_android.error("ISO trophy TROPUSR generate failed set=%s title=%s", set_name, title_id);
+        return false;
+    }
+    if (!title_id.empty())
+    {
+        const std::string mapping_path = vfs::get(vfs_trophy + "/SAMBAS3_TITLE_ID");
+        if (!fs::write_file(mapping_path, fs::rewrite, title_id))
+        {
+            rpcsx_android.warning("ISO trophy mapping write failed set=%s title=%s err=%s", set_name, title_id, fs::g_tls_error);
+        }
+    }
+    rpcsx_android.notice("S3TROPHY iso_installed title=%s set=%s", title_id, set_name);
+    return true;
+}
