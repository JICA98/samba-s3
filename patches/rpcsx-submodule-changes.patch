+struct ProcessMemStats {
+  u64 vm_size_kb = 0;
+  u64 vm_rss_kb = 0;
+  u64 vm_hwm_kb = 0;
+  u64 map_count = 0;
+};
+
+static ProcessMemStats read_process_mem_stats() {
+  ProcessMemStats stats{};
+  std::ifstream status("/proc/self/status");
+  std::string line;
+  while (std::getline(status, line)) {
+    if (line.compare(0, 7, "VmSize:") == 0) {
+      unsigned long long value = 0;
+      if (std::sscanf(line.c_str(), "VmSize: %llu", &value) == 1) stats.vm_size_kb = static_cast<u64>(value);
+    } else if (line.compare(0, 6, "VmRSS:") == 0) {
+      unsigned long long value = 0;
+      if (std::sscanf(line.c_str(), "VmRSS: %llu", &value) == 1) stats.vm_rss_kb = static_cast<u64>(value);
+    } else if (line.compare(0, 6, "VmHWM:") == 0) {
+      unsigned long long value = 0;
+      if (std::sscanf(line.c_str(), "VmHWM: %llu", &value) == 1) stats.vm_hwm_kb = static_cast<u64>(value);
+    }
+  }
+  std::ifstream maps("/proc/self/maps");
+  while (std::getline(maps, line)) {
+    stats.map_count++;
+  }
+  return stats;
+}
+
+static std::string build_batch_result_json(
+    const std::string& status,
+    u32 total_modules,
+    u32 cached_before,
+    u32 cached_after,
+    u32 compiled_this_batch,
+    const ProcessMemStats& start_mem,
+    const ProcessMemStats& end_mem,
+    const std::string& message,
+    u32 enqueued = 0,
+    u32 remaining_uncached = 0) {
+  // A complete receipt requires a sealed traversal and a final validated-cache
+  // count equal to the required-object inventory. Status alone is not proof.
+  const bool sealed = status == "all_complete" && remaining_uncached == 0 &&
+      cached_after == total_modules && compiled_this_batch <= enqueued;
+  std::ostringstream ss;
+  ss << "{"
+     << "\"status\":\"" << status << "\","
+     << "\"totalModules\":" << total_modules << ","
+     << "\"cachedBefore\":" << cached_before << ","
+     << "\"cachedAfter\":" << cached_after << ","
+     << "\"compiledThisBatch\":" << compiled_this_batch << ","
+     << "\"enqueued\":" << (enqueued ? enqueued : compiled_this_batch) << ","
+     << "\"remainingUncached\":" << remaining_uncached << ","
+     << "\"inventorySealed\":" << (sealed ? "true" : "false") << ","
+     << "\"audited\":" << (sealed ? "true" : "false") << ","
+     << "\"startVmSizeKb\":" << start_mem.vm_size_kb << ","
+     << "\"endVmSizeKb\":" << end_mem.vm_size_kb << ","
+     << "\"peakVmRssKb\":" << (end_mem.vm_hwm_kb ? end_mem.vm_hwm_kb : (end_mem.vm_rss_kb > start_mem.vm_rss_kb ? end_mem.vm_rss_kb : start_mem.vm_rss_kb)) << ","
+     << "\"startMapCount\":" << start_mem.map_count << ","
+     << "\"endMapCount\":" << end_mem.map_count << ","
+     << "\"message\":\"" << message << "\""
+     << "}";
+  return ss.str();
+}
