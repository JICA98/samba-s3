+bool iso_dev::validateExtentRange(const iso::DirEntry& entry) const
+{
+	const std::size_t block_size = m_dev->block_size();
+	if (block_size == 0)
+	{
+		return false;
+	}
+	const u64 length = entry.length.value();
+	const std::size_t first_block = entry.lba.value();
+	const std::size_t block_count = static_cast<std::size_t>((length + block_size - 1) / block_size);
+	// Empty files have 0 blocks and do not need range check beyond LBA sanity
+	if (length == 0)
+	{
+		// Even zero-length should have LBA within device if non-zero? But many ISOs set LBA 0 for zero files.
+		// Allow any LBA for zero length as it will not be read.
+		return true;
+	}
+	if (first_block >= m_dev->block_count())
+	{
+		return false;
+	}
+	if (block_count > m_dev->block_count() - first_block)
+	{
+		return false;
+	}
+	if (first_block >= m_volume_block_count)
+	{
+		return false;
+	}
+	if (block_count > m_volume_block_count - first_block)
+	{
+		return false;
+	}
+	return true;
+}
