+// Android consumes a prepared snapshot. The JNI getter only serializes the
+// latest cached values; metric acquisition is rate-limited and entirely idle
+// until the Kotlin monitor subscribes.
+struct android_perf_metrics_state
+{
+    std::mutex mutex;
+    bool enabled = false;
+    u32 interval_ms = 300;
+    u64 last_update_us = 0;
+    u64 last_crosscheck_log_us = 0;
+    u64 last_timestamp_us = 0;
+    u64 last_presented_frame_count = 0;
+    u64 last_present_timestamp_us = 0;
+    bool sample_ready = false;
+    bool frame_sample_ready = false;
+    bool was_paused = false;
+    u64 ppu_cycles = 0;
+    u64 spu_cycles = 0;
+    u64 rsx_cycles = 0;
+    u64 total_threads = 0;
+    f32 fps = 0.f;
+    f32 frametime_ms = 0.f;
+    f32 host_cpu = 0.f;
+    f32 ppu_cpu = 0.f;
+    f32 spu_cpu = 0.f;
+    f32 rsx_cpu = 0.f;
+    u32 ppu_threads = 0;
+    u32 spu_threads = 0;
+    u32 rsx_load = 0;
+    struct timed_sample
+    {
+        u64 timestamp_us = 0;
+        f32 value = 0.f;
+    };
+
+    u64 presented_frame_count = 0;
+    u64 vblank_count = 0;
+    u64 vblank_delta = 0;
+    std::deque<timed_sample> fps_samples;
+    std::deque<timed_sample> frametime_samples;
+    std::deque<timed_sample> pending_frametime_samples;
+    utils::cpu_stats cpu_stats{};
+};
+
+static android_perf_metrics_state g_android_perf;
+// The RSX flip path is hot. Keep the disabled path to one relaxed atomic
+// load, and only take the telemetry mutex while the monitor is subscribed.
+static std::atomic<bool> g_android_perf_frame_sampling_enabled{false};
+
+extern "C" void _rpcsx_android_perf_frame_presented(u64 timestamp_us)
+{
+    if (!g_android_perf_frame_sampling_enabled.load(std::memory_order_relaxed))
+        return;
+
+    std::lock_guard lock(g_android_perf.mutex);
+    if (!g_android_perf.enabled)
+        return;
+
+    if (g_android_perf.last_present_timestamp_us != 0 && timestamp_us > g_android_perf.last_present_timestamp_us)
+    {
+        const f32 frame_time_ms = static_cast<f32>(timestamp_us - g_android_perf.last_present_timestamp_us) / 1000.f;
+        g_android_perf.frametime_samples.push_back({timestamp_us, frame_time_ms});
+        g_android_perf.pending_frametime_samples.push_back({timestamp_us, frame_time_ms});
+        while (g_android_perf.frametime_samples.size() > 240)
+            g_android_perf.frametime_samples.pop_front();
+    }
+
+    g_android_perf.last_present_timestamp_us = timestamp_us;
+    ++g_android_perf.presented_frame_count;
+}
