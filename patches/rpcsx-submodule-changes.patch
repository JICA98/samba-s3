   rpcsx_android.notice("S3SAVE recovery-boot path='%s' result=%d",
                        savestate_path.c_str(), static_cast<int>(result));
+
+  // A restored PPU normally releases the boot handoff after all restored
+  // threads enter the scheduler.  On Android, some restores can leave one
+  // thread in the savestate bootstrap path indefinitely: BootGame() has
+  // returned successfully, but the emulator remains in Starting and no
+  // thread emits the normal "Final Thread" handoff.  Keep the normal path
+  // intact, but give it a bounded recovery path through the serialized core
+  // lifecycle worker.  The emulation identifier prevents a late watchdog
+  // from touching a subsequent boot after this one was stopped.
+  if (result == game_boot_result::no_errors && Emu.IsStarting()) {
+    const auto emu_id = Emu.GetEmulationIdentifier();
+    std::thread([emu_id, savestate_path]() {
+      std::this_thread::sleep_for(std::chrono::seconds(30));
+      g_coreDispatch.push([emu_id, savestate_path]() {
+        if (Emu.GetEmulationIdentifier() != emu_id || !Emu.IsStarting()) {
+          return;
+        }
+
+        rpcsx_android.warning(
+            "S3SAVE recovery-finalize watchdog path='%s' emu_id=%llu",
+            savestate_path.c_str(), static_cast<unsigned long long>(emu_id));
+        Emu.FinalizeRunRequest();
+        rpcsx_android.notice("S3SAVE recovery-finalize state=%d",
+                             static_cast<int>(Emu.GetStatus(false)));
+      });
+    }).detach();
+  }
+
   return static_cast<int>(result);
