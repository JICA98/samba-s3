+std::optional<std::string> StagedGameInstaller::prepare() {
+  if (m_prepared) return "Installer was prepared more than once";
+  if (!isValidTitleIdForPath(m_titleId)) {
+    return fmt::format("Invalid TITLE_ID for install path: %s", m_titleId);
+  }
+
+  for (const std::string* root : {&m_gamesRoot, &m_stagingRoot, &m_backupRoot,
+                                  &m_transactionRoot}) {
+    if (auto error = ensureDirectory(*root)) return error;
+  }
+
+  for (unsigned attempt = 0; attempt < 64; ++attempt) {
+    m_token = makeToken();
+    m_stagingPath = join(m_stagingRoot, fmt::format("%s.%s", m_titleId, m_token));
+    m_backupPath = join(m_backupRoot, fmt::format("%s.%s", m_titleId, m_token));
+    m_markerPath = join(m_transactionRoot, fmt::format("%s.%s.txn", m_titleId, m_token));
+
+    std::error_code error;
+    if (std::filesystem::create_directory(m_stagingPath, error)) break;
+    if (error && error != std::errc::file_exists) {
+      return fmt::format("Failed to create staging directory %s: %s",
+                         m_stagingPath, error.message());
+    }
+    m_stagingPath.clear();
+  }
+  if (m_stagingPath.empty()) return "Failed to allocate a unique staging directory";
+
+  m_prepared = true;
+  if (auto error = writeMarker(TransactionPhase::Prepared)) {
+    cleanupStaging();
+    return error;
+  }
+  if (shouldInject(InjectPoint::AfterStagingCreate)) {
+    return "Injected failure after staging creation";
+  }
+  return std::nullopt;
+}
+
+std::optional<std::string> StagedGameInstaller::writeMarker(TransactionPhase phase) {
+  const std::string content = fmt::format(
+      "version=1\ntitle=%s\ntoken=%s\nphase=%s\n", m_titleId, m_token,
+      phaseName(phase));
+  fs::file source(content.data(), content.size());
+  const auto result = copyFileAtomically(source, m_markerPath, content.size());
+  if (!result) return result.error;
+  return std::nullopt;
+}
+
+bool StagedGameInstaller::removeMarker() {
+  return !removeFile(m_markerPath).has_value();
+}
+
+bool StagedGameInstaller::restoreBackup() {
+  if (!m_backupMoved || exists(m_finalPath) || !exists(m_backupPath)) return true;
+  if (!fs::rename(m_backupPath, m_finalPath, false)) return false;
+  m_backupMoved = false;
+  return true;
+}
+
+std::optional<std::string> StagedGameInstaller::extract(iso_dev& iso,
+                                                        ProgressReporter& reporter) {
+  if (!m_prepared || !isDirectory(m_stagingPath)) return "Installer is not prepared";
+
+  for (const ManifestEntry& entry : m_manifest.dirEntries) {
+    const std::string destination = join(m_stagingPath, entry.relativePath);
+    if (!isPathWithinRoot(m_stagingPath, destination)) {
+      return fmt::format("Directory escapes staging root: %s", entry.relativePath);
+    }
+    if (auto error = ensureDirectory(destination)) return error;
+  }
+
+  const long total = static_cast<long>(m_manifest.fileEntries.size());
+  long processed = 0;
+  if (!reporter.report(0, total, "Extracting files")) return "ISO extraction was cancelled";
+
+  for (const ManifestEntry& entry : m_manifest.fileEntries) {
+    if (shouldInject(InjectPoint::DuringExtract) && processed == total / 2) {
+      return "Injected failure during extraction";
+    }
+
+    const std::string destination = join(m_stagingPath, entry.relativePath);
+    if (!isPathWithinRoot(m_stagingPath, destination)) {
+      return fmt::format("File escapes staging root: %s", entry.relativePath);
+    }
+    if (auto error = ensureDirectory(normalize(destination).parent_path().string())) return error;
+
+    auto sourceHandle = iso.open(entry.relativePath, fs::read);
+    if (!sourceHandle) return fmt::format("Failed to open ISO file: %s", entry.relativePath);
+    fs::file source;
+    source.reset(std::move(sourceHandle));
+    const auto copy = copyFileAtomically(source, destination, entry.expectedSize);
+    if (!copy) return copy.error;
+
+    if (!reporter.report(++processed, total, "Extracting files")) {
+      return "ISO extraction was cancelled";
+    }
+  }
+  return std::nullopt;
+}
+
+std::optional<std::string> StagedGameInstaller::verify(ProgressReporter* reporter) {
+  if (!m_prepared || !isDirectory(m_stagingPath)) return "Staging directory is unavailable";
+  if (reporter && !reporter->report(0, 1, "Verifying staged game")) {
+    return "ISO verification was cancelled";
+  }
+
+  for (const ManifestEntry& entry : m_manifest.dirEntries) {
+    const std::string path = join(m_stagingPath, entry.relativePath);
+    if (!isPathWithinRoot(m_stagingPath, path) || !isDirectory(path)) {
+      return fmt::format("Missing staged directory: %s", entry.relativePath);
+    }
+  }
+  for (const ManifestEntry& entry : m_manifest.fileEntries) {
+    const std::string path = join(m_stagingPath, entry.relativePath);
+    if (!isPathWithinRoot(m_stagingPath, path) || !isRegularFile(path)) {
+      return fmt::format("Missing staged file: %s", entry.relativePath);
+    }
+    std::error_code error;
+    const auto size = std::filesystem::file_size(path, error);
+    if (error || size != entry.expectedSize) {
+      return fmt::format("Staged size mismatch for %s", entry.relativePath);
+    }
+  }
+
+  for (const std::string required : {m_manifest.paramSfoPath(), m_manifest.ebootPath()}) {
+    if (required.empty()) return "Required PARAM.SFO or EBOOT is absent from manifest";
+    const std::string path = join(m_stagingPath, required);
+    fs::file file(path, fs::read);
+    if (!isPathWithinRoot(m_stagingPath, path) || !isRegularFile(path) || !file ||
+        file.size() == 0) {
+      return fmt::format("Required staged file is missing, empty, or unreadable: %s", required);
+    }
+  }
+
+  if (reporter && !reporter->report(1, 1, "Staged game verified")) {
+    return "ISO verification was cancelled";
+  }
+  return std::nullopt;
+}
+
+std::optional<std::string> StagedGameInstaller::commit(ProgressReporter* reporter) {
+  if (!m_prepared || !isDirectory(m_stagingPath)) return "Verified staging directory is unavailable";
+  if (shouldInject(InjectPoint::BeforeCommit)) return "Injected failure before commit";
+  if (reporter && !reporter->report(0, 1, "Committing game")) return "Commit was cancelled";
+
+  if (exists(m_finalPath)) {
+    if (!isDirectory(m_finalPath) || exists(m_backupPath)) {
+      return "Final title or backup path is not in a committable state";
+    }
+    if (!fs::rename(m_finalPath, m_backupPath, false)) {
+      return fmt::format("Failed to move existing title to owned backup: %s", fs::g_tls_error);
+    }
+    m_backupMoved = true;
+    if (auto error = writeMarker(TransactionPhase::BackupMoved)) {
+      if (!restoreBackup()) return fmt::format("%s; backup restoration also failed", *error);
+      return error;
+    }
+    if (shouldInject(InjectPoint::AfterBackupRename)) {
+      return "Injected failure after backup rename";
+    }
+  }
+
+  if (!fs::rename(m_stagingPath, m_finalPath, false)) {
+    const bool restored = restoreBackup();
+    return fmt::format("Failed to move staged title into place%s: %s",
+                       restored ? "" : " and failed to restore backup", fs::g_tls_error);
+  }
+  m_newTitleMoved = true;
+
+  if (shouldInject(InjectPoint::AfterStagingRename)) {
+    return "Injected failure after staging rename";
+  }
+  if (!isDirectory(m_finalPath)) {
+    return "Committed title directory could not be verified";
+  }
+
+  if (auto error = writeMarker(TransactionPhase::NewTitleMoved)) return error;
+  if (m_backupMoved) {
+    if (auto error = removeTree(m_backupPath)) return error;
+    m_backupMoved = false;
+  }
+  if (!removeMarker()) return "Committed title but failed to remove transaction marker";
+
+  m_committed = true;
+  if (reporter) reporter->report(1, 1, "Game committed");
+  return std::nullopt;
+}
+
+std::optional<std::string> StagedGameInstaller::install(iso_dev& iso,
+                                                        ProgressReporter& reporter) {
+  if (auto error = prepare()) return error;
+  if (auto error = extract(iso, reporter)) return error;
+  if (auto error = verify(&reporter)) return error;
+  return commit(&reporter);
+}
+
+void StagedGameInstaller::cleanupStaging() {
+  if (m_committed) return;
+
+  if (m_newTitleMoved) {
+    // The new title reached its final name. Leave the marker and backup for the
+    // validated recovery state machine; deleting either here could lose data.
+    return;
+  }
+
+  restoreBackup();
+  if (!m_stagingPath.empty() && isPathWithinRoot(m_stagingRoot, m_stagingPath)) {
+    removeTree(m_stagingPath);
+  }
+  if (!m_backupMoved) removeMarker();
+}
+
+bool StagedGameInstaller::finalExists() const { return isDirectory(m_finalPath); }
+
+std::optional<std::string> StagedGameInstaller::recoverStaleTransactions(
+    const std::string& configDir) {
+  const std::string base = normalize(configDir).string();
+  const std::string gamesRoot = join(base, "games");
+  const std::string stagingRoot = join(base, ".install-staging");
+  const std::string backupRoot = join(base, ".install-backups");
+  const std::string transactionRoot = join(base, ".install-transactions");
+  if (!exists(transactionRoot)) return std::nullopt;
+
+  std::error_code iterationError;
+  for (const auto& entry : std::filesystem::directory_iterator(transactionRoot, iterationError)) {
+    if (iterationError) return fmt::format("Failed to scan transaction markers: %s", iterationError.message());
+    if (!entry.is_regular_file()) return "Unexpected non-file in transaction marker directory";
+
+    const auto marker = readMarker(entry.path().string());
+    if (!marker) return fmt::format("Invalid transaction marker: %s", entry.path().string());
+
+    const std::string expectedMarker = join(transactionRoot,
+        fmt::format("%s.%s.txn", marker->titleId, marker->token));
+    if (normalize(expectedMarker) != normalize(entry.path().string())) {
+      return fmt::format("Transaction marker name/content mismatch: %s", entry.path().string());
+    }
+
+    const std::string finalPath = join(gamesRoot, marker->titleId);
+    const std::string stagingPath = join(stagingRoot,
+        fmt::format("%s.%s", marker->titleId, marker->token));
+    const std::string backupPath = join(backupRoot,
+        fmt::format("%s.%s", marker->titleId, marker->token));
+    if (!isPathWithinRoot(gamesRoot, finalPath) ||
+        !isPathWithinRoot(stagingRoot, stagingPath) ||
+        !isPathWithinRoot(backupRoot, backupPath)) {
+      return "Validated transaction paths failed containment checks";
+    }
+
+    const bool hasFinal = exists(finalPath);
+    const bool hasStaging = exists(stagingPath);
+    const bool hasBackup = exists(backupPath);
+    if (!hasFinal && hasBackup) {
+      if (!fs::rename(backupPath, finalPath, false)) {
+        return fmt::format("Failed to restore stale title backup: %s", fs::g_tls_error);
+      }
+      if (hasStaging) {
+        if (auto error = removeTree(stagingPath)) return error;
+      }
+    } else if (hasFinal && !hasStaging) {
+      if (hasBackup) {
+        if (auto error = removeTree(backupPath)) return error;
+      }
+    } else if (hasFinal && hasStaging && !hasBackup) {
+      if (auto error = removeTree(stagingPath)) return error;
+    } else if (!hasFinal && hasStaging && !hasBackup) {
+      if (auto error = removeTree(stagingPath)) return error;
+    } else if (hasFinal && hasStaging && hasBackup) {
+      return "Ambiguous transaction state; refusing destructive recovery";
+    }
+
+    if (auto error = removeFile(entry.path().string())) return error;
+  }
+  return std::nullopt;
+}
+} // namespace rpcsx::android
