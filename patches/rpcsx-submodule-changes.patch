diff --git a/android/src/iso-install-manifest.cpp b/android/src/iso-install-manifest.cpp
new file mode 100644
index 000000000..a99a18839
--- /dev/null
+++ b/android/src/iso-install-manifest.cpp
@@ -0,0 +1,189 @@
+#include "iso-install-manifest.hpp"
+
+#include "util/StrFmt.h"
+
+#include <algorithm>
+#include <cctype>
+#include <filesystem>
+#include <unordered_set>
+
+namespace rpcsx::android {
+namespace {
+bool equalsIgnoreCase(std::string_view lhs, std::string_view rhs) {
+  return lhs.size() == rhs.size() &&
+         std::equal(lhs.begin(), lhs.end(), rhs.begin(), [](char left, char right) {
+           return std::tolower(static_cast<unsigned char>(left)) ==
+                  std::tolower(static_cast<unsigned char>(right));
+         });
+}
+
+std::string foldAscii(std::string value) {
+  std::transform(value.begin(), value.end(), value.begin(), [](char character) {
+    return static_cast<char>(std::tolower(static_cast<unsigned char>(character)));
+  });
+  return value;
+}
+
+std::string appendComponent(std::string_view parent, std::string_view component) {
+  if (parent.empty()) return std::string(component);
+  return fmt::format("%s/%s", parent, component);
+}
+} // namespace
+
+bool IsoInstallManifest::isValidTitleId(std::string_view titleId) {
+  if (titleId.size() != 9) return false;
+  for (std::size_t index = 0; index < titleId.size(); ++index) {
+    const unsigned char character = static_cast<unsigned char>(titleId[index]);
+    if (index < 4 ? !std::isupper(character) : !std::isdigit(character)) return false;
+  }
+  return true;
+}
+
+bool IsoInstallManifest::isValidPathComponent(std::string_view component) {
+  if (component.empty() || component == "." || component == "..") return false;
+  for (const unsigned char character : component) {
+    if (character == 0 || character == '/' || character == '\\' ||
+        character == ':' || character < 0x20 || character == 0x7f) {
+      return false;
+    }
+  }
+  return true;
+}
+
+std::optional<std::string> IsoInstallManifest::normalizeAndValidateRelativePath(
+    const std::string& relativePath, std::string& error) {
+  if (relativePath.empty() || relativePath.front() == '/' || relativePath.front() == '\\') {
+    error = fmt::format("Path must be non-empty and relative: %s", relativePath);
+    return std::nullopt;
+  }
+
+  std::string normalized;
+  std::size_t begin = 0;
+  while (begin <= relativePath.size()) {
+    const std::size_t separator = relativePath.find_first_of("/\\", begin);
+    const std::size_t end = separator == std::string::npos ? relativePath.size() : separator;
+    const std::string_view component(relativePath.data() + begin, end - begin);
+    if (!isValidPathComponent(component)) {
+      error = fmt::format("Invalid path component in %s", relativePath);
+      return std::nullopt;
+    }
+    if (!normalized.empty()) normalized += '/';
+    normalized.append(component);
+    if (separator == std::string::npos) break;
+    begin = separator + 1;
+  }
+
+  return normalized;
+}
+
+bool isPathWithinRoot(const std::string& root, const std::string& candidate) {
+  const std::filesystem::path normalizedRoot = std::filesystem::path(root).lexically_normal();
+  const std::filesystem::path normalizedCandidate = std::filesystem::path(candidate).lexically_normal();
+  if (normalizedRoot.empty() || normalizedCandidate.empty() ||
+      normalizedRoot.root_name() != normalizedCandidate.root_name() ||
+      normalizedRoot.root_directory() != normalizedCandidate.root_directory()) {
+    return false;
+  }
+
+  auto rootPart = normalizedRoot.begin();
+  auto candidatePart = normalizedCandidate.begin();
+  for (; rootPart != normalizedRoot.end(); ++rootPart, ++candidatePart) {
+    if (candidatePart == normalizedCandidate.end() || *rootPart != *candidatePart) return false;
+  }
+  return candidatePart != normalizedCandidate.end();
+}
+
+std::optional<IsoInstallManifest> IsoInstallManifest::build(iso_dev& iso, std::string& error) {
+  IsoInstallManifest manifest;
+  std::vector<std::string> directories{std::string{}};
+  std::unordered_set<std::string> destinations;
+
+  for (std::size_t directoryIndex = 0; directoryIndex < directories.size(); ++directoryIndex) {
+    const std::string current = directories[directoryIndex];
+    auto directoryHandle = iso.open_dir(current);
+    if (!directoryHandle) {
+      error = fmt::format("Failed to read ISO directory: %s", current.empty() ? "/" : current);
+      return std::nullopt;
+    }
+
+    fs::dir directory;
+    directory.reset(std::move(directoryHandle));
+    for (const fs::dir_entry& source : directory) {
+      if (source.name == "." || source.name == "..") continue;
+      if (!isValidPathComponent(source.name)) {
+        error = fmt::format("Invalid ISO path component: %s", source.name);
+        return std::nullopt;
+      }
+      if (current.empty() && source.is_directory && equalsIgnoreCase(source.name, "PS3_UPDATE")) {
+        continue;
+      }
+
+      std::string validationError;
+      const auto relativePath = normalizeAndValidateRelativePath(
+          appendComponent(current, source.name), validationError);
+      if (!relativePath) {
+        error = std::move(validationError);
+        return std::nullopt;
+      }
+
+      if (!destinations.emplace(foldAscii(*relativePath)).second) {
+        error = fmt::format("Duplicate normalized ISO destination: %s", *relativePath);
+        return std::nullopt;
+      }
+
+      ManifestEntry entry{
+          .type = source.is_directory ? ManifestEntryType::Directory : ManifestEntryType::File,
+          .relativePath = *relativePath,
+          .expectedSize = source.is_directory ? 0 : source.size,
+      };
+      manifest.entries.push_back(entry);
+      if (source.is_directory) {
+        manifest.dirEntries.push_back(entry);
+        directories.push_back(entry.relativePath);
+      } else {
+        manifest.fileEntries.push_back(entry);
+      }
+    }
+  }
+
+  if (manifest.fileEntries.empty()) {
+    error = "ISO contains no installable files";
+    return std::nullopt;
+  }
+  if (!manifest.hasParamSfo()) {
+    error = "ISO manifest is missing PS3_GAME/PARAM.SFO";
+    return std::nullopt;
+  }
+  if (!manifest.hasEboot()) {
+    error = "ISO manifest is missing a supported EBOOT executable";
+    return std::nullopt;
+  }
+  return manifest;
+}
+
+bool IsoInstallManifest::hasParamSfo() const { return !paramSfoPath().empty(); }
+
+bool IsoInstallManifest::hasEboot() const { return !ebootPath().empty(); }
+
+std::string IsoInstallManifest::paramSfoPath() const {
+  for (const ManifestEntry& entry : fileEntries) {
+    if (equalsIgnoreCase(entry.relativePath, "PS3_GAME/PARAM.SFO")) return entry.relativePath;
+  }
+  return {};
+}
+
+std::string IsoInstallManifest::ebootPath() const {
+  static constexpr std::string_view candidates[] = {
+      "EBOOT.BIN",
+      "USRDIR/EBOOT.BIN",
+      "USRDIR/ISO.BIN.EDAT",
+      "PS3_GAME/USRDIR/EBOOT.BIN",
+  };
+  for (const std::string_view candidate : candidates) {
+    for (const ManifestEntry& entry : fileEntries) {
+      if (equalsIgnoreCase(entry.relativePath, candidate)) return entry.relativePath;
+    }
+  }
+  return {};
+}
+} // namespace rpcsx::android
