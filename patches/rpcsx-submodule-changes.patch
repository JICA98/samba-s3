+#pragma once
+
+#include "util/types.hpp"
+
+#include <functional>
+#include <optional>
+#include <string>
+
+enum class CompileDomain : int
+{
+    PPU = 0,
+    SHADER = 1,
+};
+
+enum class CompilePhase : int
+{
+    BEGIN = 0,
+    PROGRESS = 1,
+    COMPLETED = 2,
+    FAILED = 3,
+    CANCELED = 4,
+};
+
+enum class CompileOrigin : int
+{
+    INSTALL = 0,
+    RUNTIME = 1,
+};
+
+struct PpuProgressSnapshot
+{
+    int percentValue = 0; // 0..100 — same value driving the RSX progress bar
+    int percentMax = 100;
+    std::string message; // verbatim progr — e.g. "Progress: file 21 of 78, module 24 of 33 (10m remaining)"
+    int fileDone = 0;
+    int fileTotal = 0;
+    int moduleDone = 0;
+    int moduleTotal = 0;
+};
+
+struct CompileEvent
+{
+    CompileDomain domain;
+    CompilePhase phase;
+    CompileOrigin origin;
+    u64 jobId = 0; // stable per PPU session or pipeline job
+    std::optional<PpuProgressSnapshot> ppu;
+};
+
+// Global event sink — platform neutral, thread-safe copy-then-invoke
+using compile_event_sink_t = std::function<void(const CompileEvent&)>;
+
+void set_compile_event_sink(compile_event_sink_t sink);
+compile_event_sink_t get_compile_event_sink();
+void emit_compile_event(const CompileEvent& ev);
+u64 allocate_compile_job_id();
+
+// System-progress origin context (install vs runtime). Process-wide, mutex protected
+// because CompilationQueue and progress_dialog_server run on different threads.
+// Default origin is RUNTIME. CompilationQueue::impl sets INSTALL immediately before
+// ppu_precompile and clears it after.
+struct SystemProgressContext
+{
+    CompileOrigin origin = CompileOrigin::RUNTIME;
+    u64 jobId = 0;
+};
+
+void set_system_progress_context(const SystemProgressContext& ctx);
+SystemProgressContext get_system_progress_context();
+void clear_system_progress_context();
+
+// Helper that computes PpuProgressSnapshot exactly once, preserving time_left_queue
+// smoothing state. Both the RSX UI and the Android bridge consume the same snapshot.
+// Must be called before the show_overlay_message early-continue so the Android path
+// still receives the update.
+PpuProgressSnapshot build_system_progress_snapshot(
+    u32 fdone, u32 ftotal,
+    u32 pdone, u32 ptotal,
+    u64 fknown_bits, u64 ftotal_bits,
+    const std::string& text1,
+    u64 start_time,
+    std::vector<std::pair<u64, u64>>& time_left_queue,
+    usz& time_left_queue_idx,
+    const std::string& base_progr_prefix);
+
+// Convenience that builds snapshot with current g_progr_* state. Exposed for testing.
+PpuProgressSnapshot build_system_progress_snapshot_from_state(
+    const std::string& text1,
+    u64 start_time,
+    std::vector<std::pair<u64, u64>>& time_left_queue,
+    usz& time_left_queue_idx);
