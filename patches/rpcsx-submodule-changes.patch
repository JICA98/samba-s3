+extern "C" bool _rpcsx_setCompileProgressListener(JNIEnv* env, jobject callback)
+{
+  std::lock_guard<std::mutex> lock(g_compile_callback_mutex);
+  if (g_compile_callback)
+  {
+    env->DeleteGlobalRef(g_compile_callback);
+    g_compile_callback = nullptr;
+    g_compile_callback_method = nullptr;
+  }
+
+  if (!callback)
+  {
+    set_compile_event_sink(nullptr);
+    return true;
+  }
+
+  env->GetJavaVM(&g_compile_jvm);
+  g_compile_callback = env->NewGlobalRef(callback);
+
+  // Look the method up on the fun-interface class so a Kotlin SAM lambda still
+  // resolves. Descriptor must include both Longs (jobId AND max): III J J J String IIII.
+  jclass iface = env->FindClass("com/zenithblue/sambas3/RPCSX$CompileProgressCallback");
+  if (env->ExceptionCheck()) env->ExceptionClear();
+  jclass cls = iface ? iface : env->GetObjectClass(callback);
+  g_compile_callback_method = env->GetMethodID(cls, "onEvent", kCompileProgressOnEventDescriptor);
+  if (!g_compile_callback_method)
+  {
+    __android_log_print(ANDROID_LOG_ERROR, "RPCSX-UI",
+        "setCompileProgressListener: onEvent method not found (descriptor %s)",
+        kCompileProgressOnEventDescriptor);
+    env->DeleteGlobalRef(g_compile_callback);
+    g_compile_callback = nullptr;
+    if (iface) env->DeleteLocalRef(iface);
+    if (env->ExceptionCheck()) env->ExceptionClear();
+    set_compile_event_sink(nullptr);
+    return false;
+  }
+  if (iface) env->DeleteLocalRef(iface);
+  if (env->ExceptionCheck()) env->ExceptionClear();
+
+  set_compile_event_sink([](const CompileEvent& ev) {
+    dispatchCompileEventToJava(ev);
+  });
+
+  __android_log_print(ANDROID_LOG_INFO, "RPCSX-UI", "CompileProgressListener registered domain=%d phase=%d", 0, 0);
+  return true;
+}
