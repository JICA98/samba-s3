+		key["ppu_settings"]["set_sat_bit"] = g_cfg.core.ppu_set_sat_bit.get();
+		key["ppu_settings"]["set_fpcc"] = g_cfg.core.ppu_set_fpcc.get();
+		key["ppu_settings"]["set_vnan"] = g_cfg.core.ppu_set_vnan.get();
+		key["ppu_settings"]["use_nj_bit"] = g_cfg.core.ppu_use_nj_bit.get();
+		key["ppu_settings"]["codegen_mode"] = static_cast<u32>(g_cfg.core.ppu_codegen_mode.get());
+		key["patches"] = nlohmann::json::object();
+		key["patches"]["engine_version"] = patch_engine_version;
+		key["patches"]["patch_yml"] = ppu_manifest_file_digest(patch_engine::get_patches_path() + "patch.yml");
+		key["patches"]["imported_patch_yml"] = ppu_manifest_file_digest(patch_engine::get_imported_patch_path());
+		key["patches"]["patch_config_yml"] = ppu_manifest_file_digest(patch_engine::get_patch_config_path());
+		return key;
+}
