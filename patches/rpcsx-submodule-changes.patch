+} // namespace
+
+bool isValidTitleIdForPath(std::string_view titleId) {
+  return IsoInstallManifest::isValidTitleId(titleId);
+}
+
+StagedGameInstaller::StagedGameInstaller(const std::string& configDir,
+                                         const std::string& titleId,
+                                         const IsoInstallManifest& manifest)
+  : m_configDir(configDir), m_titleId(titleId), m_manifest(manifest) {
+  // configDir is expected to end with '/'
+  std::string base = m_configDir;
+  if (!base.ends_with("/")) base += "/";
+  m_finalPath = base + "games/" + std::string(titleId);
+  // staging outside games tree but same filesystem: base + ".staging/<title>_<unique>"
+  // We'll generate unique in prepare()
+  m_markerPath = base + "games/.install_" + std::string(titleId) + ".transaction";
+}
+
+StagedGameInstaller::~StagedGameInstaller() {
+  // Do not auto-remove on destruction; caller must explicitly cleanup or commit
+}
+
+std::string StagedGameInstaller::generateUniqueStagingPath() {
+  std::string base = m_configDir;
+  if (!base.ends_with("/")) base += "/";
+  // Use .staging under config dir (sibling to games, same FS)
+  return base + ".staging/" + m_titleId + "_" + uniqueSuffix();
+}
+
+std::string StagedGameInstaller::generateUniqueBackupPath() {
+  // backup is sibling to final: finalPath + ".backup.<unique>"
+  return m_finalPath + ".backup." + uniqueSuffix();
+}
+
+bool StagedGameInstaller::isOwnedPath(const std::string& path) const {
+  // Owned paths are exactly stagingPath, backupPath, markerPath, or children thereof
+  // And must be within configDir
+  if (path.empty()) return false;
+  std::string cfg = m_configDir;
+  if (!cfg.ends_with("/")) cfg += "/";
+  // Must be under cfg
+  if (path.rfind(cfg, 0) != 0) return false;
+  // Check is staging, backup, marker, or inside staging
+  if (path == m_stagingPath) return true;
+  if (path == m_backupPath) return true;
+  if (path == m_markerPath) return true;
+  if (!m_stagingPath.empty() && path.rfind(m_stagingPath + "/", 0) == 0) return true;
+  if (!m_backupPath.empty() && path.rfind(m_backupPath + "/", 0) == 0) return true;
+  return false;
+}
+
+std::optional<std::string> StagedGameInstaller::prepare() {
+  if (!isValidTitleIdForPath(m_titleId)) {
+    return fmt::format("Invalid TITLE_ID for path: %s", m_titleId);
+  }
+
+  m_stagingPath = generateUniqueStagingPath();
+
+  // Ensure parent .staging exists
+  std::string stagingParent = std::filesystem::path(m_stagingPath).parent_path().string();
+  std::string err;
+  if (!ensureDir(stagingParent, err)) return err;
+
+  // Ensure staging does not already exist (unique)
+  if (pathExists(m_stagingPath)) {
+    return fmt::format("Staging path already exists: %s", m_stagingPath);
+  }
+
+  std::error_code ec;
+  std::filesystem::create_directories(m_stagingPath, ec);
+  if (ec) {
+    return fmt::format("Failed to create staging %s: %s", m_stagingPath, ec.message());
+  }
+
+  if (shouldInject(InjectPoint::AfterStagingCreate)) {
+    return "Injected failure after staging create";
+  }
+
+  // Verify staging is on same filesystem as final's parent? We rely on same configDir parent being same FS.
+  // Could check device id via stat, but not needed.
+
+  m_prepared = true;
+  return std::nullopt;
+}
+
+std::optional<std::string> StagedGameInstaller::writeMarker() {
+  // Marker contains staging, backup, final for recovery
+  // Write to markerPath atomically via pending_file? Use simple file write
+  std::string content = fmt::format("staging=%s\nbackup=%s\nfinal=%s\ntitle=%s\n", m_stagingPath, m_backupPath, m_finalPath, m_titleId);
+  // Use pending_file for atomic
+  fs::pending_file pending(m_markerPath);
+  if (!pending.file) {
+    return fmt::format("Failed to create marker %s", m_markerPath);
+  }
+  pending.file.write(content.data(), content.size());
+  pending.file.sync();
+  if (!pending.commit()) {
+    return fmt::format("Failed to commit marker %s", m_markerPath);
+  }
+  return std::nullopt;
+}
+
+void StagedGameInstaller::removeMarker() {
+  if (!m_markerPath.empty() && pathExists(m_markerPath)) {
+    std::error_code ec;
+    std::filesystem::remove(m_markerPath, ec);
+  }
+}
+
+std::optional<std::string> StagedGameInstaller::extract(iso_dev& iso, ProgressReporter& reporter) {
+  if (!m_prepared) {
+    return "Installer not prepared";
+  }
+
+  // Phase: extracting
+  // Ensure we account for progress reporting distinct phases
+  // Caller will have reported scanning; we report extracting
+
+  // Create directories first
+  for (auto& e : m_manifest.dirEntries) {
+    // Construct destination inside staging
+    std::filesystem::path dest = std::filesystem::path(m_stagingPath) / e.relativePath;
+    std::string destStr = dest.string();
+    // Containment check
+    if (!isPathWithinRoot(m_stagingPath, destStr)) {
+      return fmt::format("Directory destination escapes staging: %s", destStr);
+    }
+    std::string err;
+    if (!ensureDir(destStr, err)) return err;
+  }
+
+  size_t totalFiles = m_manifest.fileEntries.size();
+  size_t processed = 0;
+
+  // Report initial extracting progress
+  reporter.report(0, totalFiles, "Extracting");
+
+  for (auto& e : m_manifest.fileEntries) {
+    if (shouldInject(InjectPoint::DuringExtract) && processed == totalFiles/2) {
+      return "Injected failure during extraction";
+    }
+
+    std::filesystem::path dest = std::filesystem::path(m_stagingPath) / e.relativePath;
+    std::string destStr = dest.string();
+
+    if (!isPathWithinRoot(m_stagingPath, destStr)) {
+      return fmt::format("File destination escapes staging: %s", destStr);
+    }
+
+    // Ensure parent dir exists
+    std::string parent = std::filesystem::path(destStr).parent_path().string();
+    if (!parent.empty()) {
+      std::string err;
+      if (!ensureDir(parent, err)) return err;
+    }
+
+    // Open file from ISO
+    auto raw_file = iso.open(e.relativePath, fs::read);
+    if (!raw_file) {
+      return fmt::format("Failed to open file in ISO: %s", e.relativePath);
+    }
+    fs::file file;
+    file.reset(std::move(raw_file));
+
+    // Validate source size matches expected (iso parser already sums)
+    if (file.size() != e.expectedSize) {
+      return fmt::format("Source size mismatch for %s: expected %llu got %llu", e.relativePath, e.expectedSize, file.size());
+    }
+
+    auto copyRes = copyFileAtomically(file, destStr, e.expectedSize);
+    if (!copyRes) {
+      return copyRes.error;
+    }
+
+    processed++;
+    // Report with ++processed to ensure final reaches N/N per plan P1
+    if (!reporter.report(processed, totalFiles, "Extracting")) {
+      // Reporter returns false if cancelled? Our Progress wrapper returns bool from onProgressEvent
+      // If cancelled, treat as failure and preserve old title (staging cleanup)
+      return "Cancelled during extraction";
+    }
+  }
+
+  // Ensure final report is N/N
+  reporter.report(totalFiles, totalFiles, "Extracting complete");
+  return std::nullopt;
+}
+
+std::optional<std::string> StagedGameInstaller::verify(ProgressReporter* reporter) {
+  if (reporter) reporter->report(0, 1, "Verifying");
+
+  // Verify every staged file against manifest expected size
+  for (auto& e : m_manifest.fileEntries) {
+    std::filesystem::path dest = std::filesystem::path(m_stagingPath) / e.relativePath;
+    std::string destStr = dest.string();
+    if (!isPathWithinRoot(m_stagingPath, destStr)) {
+      return fmt::format("Verify: destination escapes staging: %s", destStr);
+    }
+    if (!pathExists(destStr)) {
+      return fmt::format("Verify: missing staged file %s", e.relativePath);
+    }
+    if (!isRegularFile(destStr)) {
+      return fmt::format("Verify: not a regular file %s", e.relativePath);
+    }
+    u64 sz = fileSizeOnDisk(destStr);
+    if (sz != e.expectedSize) {
+      return fmt::format("Verify: size mismatch for %s: expected %llu got %llu", e.relativePath, e.expectedSize, sz);
+    }
+  }
+
+  // Verify directories exist? Could check
+  for (auto& e : m_manifest.dirEntries) {
+    std::filesystem::path dest = std::filesystem::path(m_stagingPath) / e.relativePath;
+    std::string destStr = dest.string();
+    if (!pathExists(destStr) || !isDirectory(destStr)) {
+      return fmt::format("Verify: missing staged directory %s", e.relativePath);
+    }
+  }
+
+  // Require readable PARAM.SFO and EBOOT.BIN before commit
+  // Find PARAM.SFO
+  std::string sfoRel = m_manifest.paramSfoPath();
+  if (sfoRel.empty()) {
+    return "Verify: PARAM.SFO not found in manifest";
+  }
+  std::string sfoStaged = (std::filesystem::path(m_stagingPath) / sfoRel).string();
+  if (!isRegularFile(sfoStaged)) {
+    return fmt::format("Verify: PARAM.SFO not a regular file: %s", sfoStaged);
+  }
+  {
+    fs::file f(sfoStaged, fs::read);
+    if (!f || f.size() == 0) {
+      return fmt::format("Verify: PARAM.SFO not readable or empty: %s", sfoStaged);
+    }
+  }
+
+  // EBOOT.BIN
+  std::string ebootRel = m_manifest.ebootPath();
+  if (ebootRel.empty()) {
+    return "Verify: EBOOT.BIN not found in manifest";
+  }
+  std::string ebootStaged = (std::filesystem::path(m_stagingPath) / ebootRel).string();
+  if (!isRegularFile(ebootStaged)) {
+    return fmt::format("Verify: EBOOT.BIN not a regular file: %s", ebootStaged);
+  }
+  {
+    fs::file f(ebootStaged, fs::read);
+    if (!f || f.size() == 0) {
+      return fmt::format("Verify: EBOOT.BIN not readable or empty: %s", ebootStaged);
+    }
+  }
+
+  if (reporter) reporter->report(1, 1, "Verifying complete");
+  return std::nullopt;
+}
+
+std::optional<std::string> StagedGameInstaller::commit(ProgressReporter* reporter) {
+  if (shouldInject(InjectPoint::BeforeCommit)) {
+    return "Injected failure before commit";
+  }
+
+  // Determine if final exists
+  bool finalExists = pathExists(m_finalPath);
+
+  if (finalExists) {
+    // Create backup path unique
+    m_backupPath = generateUniqueBackupPath();
+    // Ensure backup parent exists (games dir)
+    std::string err;
+    // No need to create backup parent separately; final's parent is games, which exists
+
+    // Write marker before any rename for recovery
+    if (auto errOpt = writeMarker()) return errOpt;
+
+    // Rename final -> backup
+    std::error_code ec;
+    // Use fs::rename which is atomic if same FS
+    if (!fs::rename(m_finalPath, m_backupPath, true)) {
+      removeMarker();
+      return fmt::format("Failed to backup existing title %s -> %s: %s", m_finalPath, m_backupPath, fmt::format("%s", fs::g_tls_error));
+    }
+
+    if (shouldInject(InjectPoint::AfterBackupRename)) {
+      // Simulate failure after first rename, before second
+      // Leave system in state: backup exists, final missing, staging exists, marker exists
+      // Recovery should handle
+      return "Injected failure after backup rename";
+    }
+
+    // Rename staging -> final
+    if (!fs::rename(m_stagingPath, m_finalPath, true)) {
+      // Second rename failed, restore backup
+      std::string restoreErr = "";
+      if (!fs::rename(m_backupPath, m_finalPath, true)) {
+        restoreErr = fmt::format(" and failed to restore backup: %s", fmt::format("%s", fs::g_tls_error));
+      }
+      removeMarker();
+      return fmt::format("Failed to commit staging %s -> %s: %s%s", m_stagingPath, m_finalPath, fmt::format("%s", fs::g_tls_error), restoreErr);
+    }
+
+    if (shouldInject(InjectPoint::AfterStagingRename)) {
+      // Injected after staging rename but before backup removal/marker cleanup
+      // This simulates crash after second rename; recovery should clean backup
+      return "Injected failure after staging rename";
+    }
+
+    // Verify final exists
+    if (!pathExists(m_finalPath) || !isDirectory(m_finalPath)) {
+      // Try restore?
+      fs::rename(m_backupPath, m_finalPath, true);
+      removeMarker();
+      return "Commit verification failed: final not found after rename";
+    }
+
+    // Remove backup only after confirming final
+    if (isOwnedPath(m_backupPath)) {
+      std::error_code ec2;
+      std::filesystem::remove_all(m_backupPath, ec2);
+      if (ec2) {
+        // Non-fatal but warn; don't fail commit
+      }
+    } else {
+      // Never remove not owned
+    }
+
+    removeMarker();
+    m_committed = true;
+    if (reporter) reporter->report(1,1,"Committing complete");
+    return std::nullopt;
+
+  } else {
+    // No existing final, simple rename staging -> final
+    if (auto errOpt = writeMarker()) return errOpt;
+
+    if (!fs::rename(m_stagingPath, m_finalPath, true)) {
+      removeMarker();
+      return fmt::format("Failed to commit staging %s -> %s: %s", m_stagingPath, m_finalPath, fmt::format("%s", fs::g_tls_error));
+    }
+
+    // Verify
+    if (!pathExists(m_finalPath)) {
+      removeMarker();
+      return "Commit verification failed: final missing after rename";
+    }
+
+    removeMarker();
+    m_committed = true;
+    if (reporter) reporter->report(1,1,"Committing complete");
+    return std::nullopt;
+  }
+}
+
+void StagedGameInstaller::cleanupStaging() {
+  if (!m_stagingPath.empty() && isOwnedPath(m_stagingPath) && pathExists(m_stagingPath)) {
+    std::error_code ec;
+    std::filesystem::remove_all(m_stagingPath, ec);
+  }
+  removeMarker();
+  // Do not touch backup or final
+}
+
+bool StagedGameInstaller::finalExists() const {
+  return pathExists(m_finalPath);
+}
+
+std::optional<std::string> StagedGameInstaller::install(iso_dev& iso, ProgressReporter& reporter) {
+  if (auto err = prepare()) return err;
+  if (auto err = extract(iso, reporter)) {
+    cleanupStaging();
+    return err;
+  }
+  if (auto err = verify(&reporter)) {
+    cleanupStaging();
+    return err;
+  }
+  if (auto err = commit(&reporter)) {
+    // If commit failed after staging rename, staging may be gone; but backup may remain
+    // Cleanup staging if still exists (owned)
+    if (pathExists(m_stagingPath)) cleanupStaging();
+    return err;
+  }
+  return std::nullopt;
+}
+
+void StagedGameInstaller::recoverStaleTransactions(const std::string& configDir) {
+  std::string base = configDir;
+  if (!base.ends_with("/")) base += "/";
+  std::string gamesDir = base + "games";
+  std::string stagingRoot = base + ".staging";
+
+  // Clean stale .staging directories older than maybe? For now clean all staging for which no marker?
+  // Scan for transaction markers: games/.install_*.transaction
+  std::error_code ec;
+  if (!std::filesystem::exists(gamesDir, ec)) return;
+
+  for (auto& entry : std::filesystem::directory_iterator(gamesDir, ec)) {
+    if (ec) break;
+    std::string name = entry.path().filename().string();
+    if (name.rfind(".install_", 0) == 0 && name.ends_with(".transaction")) {
+      // Marker file indicates incomplete transaction
+      std::ifstream in(entry.path());
+      std::string line, staging, backup, final;
+      while (std::getline(in, line)) {
+        if (line.rfind("staging=",0)==0) staging = line.substr(8);
+        else if (line.rfind("backup=",0)==0) backup = line.substr(7);
+        else if (line.rfind("final=",0)==0) final = line.substr(6);
+      }
+      in.close();
+      // Determine state
+      bool finalExists = std::filesystem::exists(final, ec);
+      bool stagingExists = !staging.empty() && std::filesystem::exists(staging, ec);
+      bool backupExists = !backup.empty() && std::filesystem::exists(backup, ec);
+
+      // If final exists and staging not exists, transaction likely completed but marker left: remove backup and marker
+      if (finalExists && !stagingExists) {
+        if (backupExists) {
+          // Backup is owned backup that should have been removed
+          // Only remove if path looks like backup (contains .backup.)
+          if (backup.find(".backup.") != std::string::npos) {
+            std::error_code ec2;
+            std::filesystem::remove_all(backup, ec2);
+          }
+        }
+        std::error_code ec2;
+        std::filesystem::remove(entry.path(), ec2);
+      } else if (!finalExists && stagingExists && backupExists) {
+        // Failed after backup rename: staging exists, backup exists, final missing -> restore backup
+        std::error_code ec2;
+        // Only restore if backup is owned (contains .backup.)
+        if (backup.find(".backup.") != std::string::npos) {
+          fs::rename(backup, final, true);
+        }
+        // Remove staging (incomplete new) and marker
+        if (staging.rfind(base,0)==0) {
+          std::error_code ec3;
+          std::filesystem::remove_all(staging, ec3);
+        }
+        std::filesystem::remove(entry.path(), ec2);
+      } else if (!finalExists && stagingExists && !backupExists) {
+        // Failed before commit or after staging rename where final missing?
+        // If final missing and staging exists, but no backup, could be first install that failed
+        // Just remove staging and marker
+        if (staging.rfind(base,0)==0) {
+          std::error_code ec3;
+          std::filesystem::remove_all(staging, ec3);
+        }
+        std::error_code ec2;
+        std::filesystem::remove(entry.path(), ec2);
+      } else if (finalExists && stagingExists) {
+        // Both exist -> incomplete commit where staging rename failed? Remove staging
+        if (staging.rfind(base,0)==0) {
+          std::error_code ec3;
+          std::filesystem::remove_all(staging, ec3);
+        }
+        std::error_code ec2;
+        std::filesystem::remove(entry.path(), ec2);
+      } else {
+        // No staging, no final, just marker leftover -> remove marker
+        std::error_code ec2;
+        std::filesystem::remove(entry.path(), ec2);
+      }
+    }
+  }
+
+  // Also clean orphaned staging directories without marker (e.g., crash before marker write or leftover)
+  // We keep conservative: only remove staging dirs that are older than 1 hour? For now do not auto-remove without marker to be safe.
+  // But plan says "Add an incomplete/transaction marker and startup recovery if process death between renames can otherwise strand title."
+  // So marker covers rename window; staging orphan before marker is not between renames, can be cleaned on next prepare.
+
+  // Clean stale backup directories that look like .backup.<unique> and have no marker referencing them
+  // This handles case where backup was not removed due to crash after commit
+  for (auto& entry : std::filesystem::directory_iterator(gamesDir, ec)) {
+    if (ec) break;
+    std::string name = entry.path().filename().string();
+    if (name.find(".backup.") != std::string::npos) {
+      // This is a backup; check if any marker references it
+      bool referenced = false;
+      // Scan markers again
+      for (auto& m : std::filesystem::directory_iterator(gamesDir, ec)) {
+        if (m.path().extension() == ".transaction") {
+          std::ifstream in(m.path());
+          std::string content((std::istreambuf_iterator<char>(in)), std::istreambuf_iterator<char>());
+          if (content.find(entry.path().string()) != std::string::npos) {
+            referenced = true; break;
+          }
+        }
+      }
+      if (!referenced) {
+        // Orphaned backup: if final exists, safe to remove
+        std::string titlePart = name.substr(0, name.find(".backup."));
+        std::string finalPath = gamesDir + "/" + titlePart;
+        if (std::filesystem::exists(finalPath, ec)) {
+          std::error_code ec2;
+          std::filesystem::remove_all(entry.path(), ec2);
+        }
+      }
+    }
+  }
+}
