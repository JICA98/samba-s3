+static void collect_fs_directories(const std::string& root, std::vector<std::string>& out) {
+  std::string normalized = root;
+  if (!normalized.empty() && normalized.back() != '/') {
+    normalized += '/';
+  }
+  out.push_back(normalized);
+  for (const auto& entry : fs::dir(normalized)) {
+    if (!entry.is_directory || entry.name == "." || entry.name == "..") {
+      continue;
+    }
+    collect_fs_directories(normalized + std::string(entry.name), out);
+  }
+}
