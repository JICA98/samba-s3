+static std::string ppu_manifest_path()
+	{
+		const std::string title_id = Emu.GetTitleID();
+		if (title_id.empty())
+		{
+			return {};
+		}
+
+		const std::string directory = rpcs3::utils::get_cache_dir() + "ppu_manifest/";
+		if (!fs::create_path(directory))
+		{
+			ppu_log.error("PPU manifest: failed to create %s (%s)", directory, fs::g_tls_error);
+			return {};
+		}
+
+		return directory + vfs::escape(title_id, true) + ".json";
+	}
+
+	static bool ppu_manifest_entry_is_valid(const nlohmann::json& value, ppu_precompile_file_info& entry)
+	{
+		if (!value.is_object() || !value.contains("path") || !value.contains("offset") || !value.contains("file_size"))
+		{
+			return false;
+		}
+
+		if (!value["path"].is_string() || !value["offset"].is_number_unsigned() || !value["file_size"].is_number_unsigned())
+		{
+			return false;
+		}
+
+		entry.path = value["path"].get<std::string>();
+		entry.offset = value["offset"].get<u64>();
+		entry.file_size = value["file_size"].get<u64>();
+
+		std::error_code ec;
+		const std::filesystem::path path(entry.path);
+		if (!std::filesystem::is_regular_file(path, ec) || ec)
+		{
+			return false;
+		}
+
+		const u64 actual_size = std::filesystem::file_size(path, ec);
+		return !ec && entry.offset <= actual_size && entry.file_size <= actual_size - entry.offset;
+	}
+
+	static bool ppu_manifest_load(const std::string& path, const nlohmann::json& key, const std::vector<std::string>& roots, const std::string& inventory, std::vector<ppu_precompile_file_info>& entries)
+	{
+		fs::file file(path);
+		if (!file)
+		{
+			return false;
+		}
+
+		std::string contents(file.size(), '\0');
+		if (!contents.empty() && file.read(contents.data(), contents.size()) != contents.size())
+		{
+			return false;
+		}
+
+		const auto document = nlohmann::json::parse(contents, nullptr, false);
+		if (document.is_discarded() || !document.is_object() || !document.contains("version") || !document.contains("key") || !document.contains("roots") || !document.contains("inventory") || !document.contains("entries") ||
+			document["version"] != 2u || document["key"] != key || document["roots"] != roots || document["inventory"] != inventory)
+		{
+			return false;
+		}
+
+		const auto& manifest_entries = document["entries"];
+		if (!manifest_entries.is_array())
+		{
+			return false;
+		}
+
+		entries.clear();
+		entries.reserve(manifest_entries.size());
+		for (const auto& value : manifest_entries)
+		{
+			ppu_precompile_file_info entry;
+			if (!ppu_manifest_entry_is_valid(value, entry))
+			{
+				entries.clear();
+				return false;
+			}
+			entries.emplace_back(std::move(entry));
+		}
+
+		return true;
+	}
+
+	static void ppu_manifest_save(const std::string& path, const nlohmann::json& key, const std::vector<std::string>& roots, const std::string& inventory, const std::vector<ppu_precompile_file_info>& entries)
+	{
+		nlohmann::json document{
+			{"version", 2},
+			{"key", key},
+			{"roots", roots},
+			{"inventory", inventory},
+			{"entries", nlohmann::json::array()},
+		};
+
+		for (const auto& entry : entries)
+		{
+			document["entries"].push_back({
+				{"path", entry.path},
+				{"offset", entry.offset},
+				{"file_size", entry.file_size},
+			});
+		}
+
+		const std::string temporary_path = path + ".tmp";
+		if (!fs::write_file(temporary_path, fs::rewrite, document.dump()))
+		{
+			ppu_log.warning("PPU manifest: failed to write %s (%s)", temporary_path, fs::g_tls_error);
+			return;
+		}
+
+		if (!fs::rename(temporary_path, path, true))
+		{
+			ppu_log.warning("PPU manifest: failed to publish %s (%s)", path, fs::g_tls_error);
+			fs::remove_file(temporary_path);
+			return;
+		}
+
+		ppu_log.notice("PPU manifest: wrote %zu entries to %s", entries.size(), path);
+	}
+#endif
+}
