+	static u32 ppu_effective_thread_count(usz workload_size, ppu_compile_policy policy)
+	{
+		const u32 max_threads = rpcs3::utils::get_max_threads();
+		if (!workload_size || !max_threads)
+		{
+			return 0;
+		}
+
+		// Initial foreground candidate: reserve two logical CPUs for the app and
+		// system. The final cap is always owned here and never exceeds
+		// get_max_threads(), which already applies llvm_threads and hardware caps.
+		const u32 hardware_threads = utils::get_thread_count();
+		const u32 configured_foreground_threads = static_cast<u32>(g_cfg.core.ppu_foreground_threads.get());
+		const u32 foreground_candidate = configured_foreground_threads
+			? std::min(hardware_threads, configured_foreground_threads)
+			: hardware_threads > 2
+				? std::max<u32>(2, std::min<u32>(6, hardware_threads - 2))
+				: hardware_threads;
+		const u32 policy_limit = policy == ppu_compile_policy::foreground ? foreground_candidate : max_threads;
+		return std::min<u32>(::narrow<u32>(workload_size), std::min(max_threads, policy_limit));
+	}
