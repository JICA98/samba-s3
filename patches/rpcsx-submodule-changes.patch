+namespace {
+std::string uniqueSuffix() {
+  // Use timestamp + random
+  auto now = std::chrono::steady_clock::now().time_since_epoch().count();
+  std::random_device rd;
+  std::mt19937_64 gen(rd());
+  uint64_t r = gen();
+  return fmt::format("{}_{}", now, r);
+}
+
+bool ensureDir(const std::string& path, std::string& err) {
+  std::error_code ec;
+  std::filesystem::create_directories(path, ec);
+  if (ec) {
+    err = fmt::format("Failed to create dir %s: %s", path, ec.message());
+    return false;
+  }
+  return true;
+}
+
+bool pathExists(const std::string& p) {
+  std::error_code ec;
+  return std::filesystem::exists(p, ec);
+}
+
+bool isRegularFile(const std::string& p) {
+  std::error_code ec;
+  return std::filesystem::is_regular_file(p, ec);
+}
+
+bool isDirectory(const std::string& p) {
+  std::error_code ec;
+  return std::filesystem::is_directory(p, ec);
+}
+
+u64 fileSizeOnDisk(const std::string& p) {
+  std::error_code ec;
+  auto sz = std::filesystem::file_size(p, ec);
+  if (ec) return static_cast<u64>(-1);
+  return sz;
+}
