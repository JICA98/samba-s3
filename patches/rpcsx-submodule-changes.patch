+extern "C" void _rpcsx_android_trophy_unlocked(int trophy_id, const char* trophy_set)
+{
+    const std::string set = trophy_set ? trophy_set : "";
+    nlohmann::json payload{{"id", trophy_id}, {"trophySet", set}};
+    // Include the resolved item metadata in the one-shot event when the
+    // trophy files are readable. Kotlin still refreshes the complete set;
+    // this keeps the event useful to notification consumers without polling.
+    try {
+        const auto snapshot = nlohmann::json::parse(android_get_trophies_for_set(set, Emu.GetTitleID()));
+        for (const auto& entry : snapshot.value("trophies", nlohmann::json::array())) {
+            if (entry.value("id", -1) == trophy_id) {
+                payload["name"] = entry.value("name", "");
+                payload["grade"] = entry.value("grade", "");
+                payload["iconPath"] = entry.value("iconPath", "");
+                break;
+            }
+        }
+    } catch (...) {}
+    rpcsx_android.notice("S3TROPHY unlock title=%s set=%s id=%d name='%s' grade=%s",
+                        Emu.GetTitleID(), set, trophy_id,
+                        payload.value("name", "").c_str(),
+                        payload.value("grade", "").c_str());
+    const std::string serialized = payload.dump();
+    emit_frontend_event(FRONTEND_EVENT_TROPHY_UNLOCKED, &serialized);
+}
