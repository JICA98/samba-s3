+	static std::string ppu_manifest_file_digest(const std::string& path)
+	{
+		fs::file file(path);
+		if (!file)
+		{
+			return "missing";
+		}
+
+		usz digest = rpcs3::fnv_seed;
+		std::array<u8, 4096> buffer{};
+
+		while (const usz read = file.read(buffer.data(), buffer.size()))
+		{
+			for (usz i = 0; i < read; ++i)
+			{
+				digest = rpcs3::hash64(digest, buffer[i]);
+			}
+		}
+
+		return std::to_string(digest);
+	}
+
+	static bool ppu_manifest_is_candidate(const std::string& name)
+	{
+		const std::string upper = fmt::to_upper(name);
+		return upper.ends_with(".PRX") || upper.ends_with(".SPRX") || upper.ends_with(".ELF") || upper.ends_with(".SELF") || upper.ends_with(".MSELF");
+	}
+
+	static std::string ppu_manifest_source_inventory(const std::vector<std::string>& roots)
+	{
+		struct source_directory
+		{
+			std::string root;
+			std::string path;
+			usz root_index = 0;
+		};
+
+		std::vector<source_directory> directories;
+		directories.reserve(roots.size());
+		for (std::string root : roots)
+		{
+			if (!root.empty())
+			{
+				root = std::filesystem::path(root).lexically_normal().generic_string();
+				if (!root.ends_with('/'))
+				{
+					root += '/';
+				}
+				directories.push_back({std::move(root), {}, 0});
+			}
+		}
+
+		std::sort(directories.begin(), directories.end(), [](const source_directory& left, const source_directory& right)
+			{
+				return left.root < right.root;
+			});
+		directories.erase(std::unique(directories.begin(), directories.end(), [](const source_directory& left, const source_directory& right)
+			{
+				return left.root == right.root;
+			}), directories.end());
+		for (usz i = 0; i < directories.size(); ++i)
+		{
+			directories[i].path = directories[i].root;
+			directories[i].root_index = i;
+		}
+
+		std::vector<std::string> records;
+		for (usz i = 0; i < directories.size(); ++i)
+		{
+			for (const auto& entry : fs::dir(directories[i].path))
+			{
+				if (entry.is_directory)
+				{
+					if (entry.name != "." && entry.name != "..")
+					{
+						directories.push_back({directories[i].root, directories[i].path + entry.name + '/', directories[i].root_index});
+					}
+					continue;
+				}
+
+				if (!ppu_manifest_is_candidate(entry.name))
+				{
+					continue;
+				}
+
+				const std::string path = directories[i].path + entry.name;
+				const std::filesystem::path normalized_path = std::filesystem::path(path).lexically_normal();
+				const std::string relative_path = normalized_path.lexically_relative(std::filesystem::path(directories[i].root)).generic_string();
+				if (relative_path.empty() || relative_path == "." || relative_path == ".." || relative_path.starts_with("../"))
+				{
+					continue;
+				}
+				std::string record = std::to_string(directories[i].root_index) + ':' + relative_path + '|' + std::to_string(entry.size) + '|' + std::to_string(entry.mtime);
+				if (fmt::to_upper(entry.name).ends_with(".MSELF"))
+				{
+					// MSELF records can change without changing the container's metadata.
+					record += '|';
+					record += ppu_manifest_file_digest(path);
+				}
+				records.emplace_back(std::move(record));
+			}
+		}
+
+		std::sort(records.begin(), records.end());
+		usz digest = rpcs3::fnv_seed;
+		for (const std::string& record : records)
+		{
+			for (const unsigned char byte : record)
+			{
+				digest = rpcs3::hash64(digest, byte);
+			}
+			digest = rpcs3::hash64(digest, static_cast<u8>('\n'));
+		}
+		return std::to_string(digest);
+	}
