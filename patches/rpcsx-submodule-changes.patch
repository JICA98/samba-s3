+extern "C" std::string _rpcsx_getFrameLimiterStateJson()
+{
+  const frame_limit_type requested = g_cfg.video.frame_limit.get();
+  const frame_limit_type effective = g_disable_frame_limit ? frame_limit_type::none : requested;
+  const auto mode_name = [](frame_limit_type mode) -> const char*
+  {
+    switch (mode)
+    {
+    case frame_limit_type::none: return "Off";
+    case frame_limit_type::_30: return "30";
+    case frame_limit_type::_50: return "50";
+    case frame_limit_type::_60: return "60";
+    case frame_limit_type::_120: return "120";
+    case frame_limit_type::display_rate: return "Display";
+    case frame_limit_type::_auto: return "Auto";
+    case frame_limit_type::_ps3: return "PS3 Native";
+    case frame_limit_type::infinite: return "Infinite";
+    }
+    return "Unknown";
+  };
+
+  double target_fps = 0.;
+  bool target_known = true;
+  switch (effective)
+  {
+  case frame_limit_type::none:
+    target_fps = g_cfg.core.max_cpu_preempt_count_per_frame ? static_cast<double>(g_cfg.video.vblank_rate) : 0.;
+    break;
+  case frame_limit_type::_30: target_fps = 30.; break;
+  case frame_limit_type::_50: target_fps = 50.; break;
+  case frame_limit_type::_60: target_fps = 60.; break;
+  case frame_limit_type::_120: target_fps = 120.; break;
+  case frame_limit_type::display_rate:
+    target_known = false;
+    break;
+  case frame_limit_type::_auto:
+    target_fps = static_cast<double>(g_cfg.video.vblank_rate);
+    break;
+  case frame_limit_type::_ps3:
+  case frame_limit_type::infinite:
+    target_fps = 0.;
+    break;
+  }
+
+  const double second_limit = g_cfg.video.second_frame_limit;
+  if (second_limit >= 0.1 && (!target_known || target_fps < 0.1 || second_limit < target_fps))
+  {
+    target_fps = second_limit;
+    target_known = true;
+  }
+
+  nlohmann::json state{
+    {"requestedMode", mode_name(requested)},
+    {"effectiveMode", mode_name(effective)},
+    {"runtimeMutable", true},
+    {"disabledByCore", static_cast<bool>(g_disable_frame_limit)},
+    {"secondLimitFps", second_limit},
+    {"uncapped", target_known && target_fps < 0.1}
+  };
+  if (target_known) state["targetFps"] = target_fps;
+  else state["targetFps"] = nullptr;
+  return state.dump();
+}
