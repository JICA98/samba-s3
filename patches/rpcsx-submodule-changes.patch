+
+  static bool isValidTitleId(std::string_view titleId);
+  static bool isValidPathComponent(std::string_view component);
+  static std::optional<std::string> normalizeAndValidateRelativePath(const std::string& relativePath, std::string& error);
+};
+
+bool isPathWithinRoot(const std::string& root, const std::string& candidate);
+
+} // namespace rpcsx::android
