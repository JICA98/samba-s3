+bool TROPUSRLoader::LoadPhysical(std::string_view filepath)
+{
+	// This path is deliberately read-only. Calling Load() while the VFS is
+	// unmounted can fall through to Generate(), which would replace a valid
+	// user's trophy history with an empty file.
+	if (!m_file.open(std::string(filepath)))
+	{
+		return false;
+	}
+
+	const bool valid = LoadHeader() && LoadTableHeaders() && LoadTables();
+	m_file.close();
+	return valid;
+}
