+    const std::string encoded = encoded_cfg_value(schema_node);
+    auto* global_node = find_cfg_node(&global, normalized_path);
+    if (global_node && encoded == global_encoded) {
+      values.erase(normalized_path);
+    } else {
+      values[normalized_path] = encoded;
+    }
+  }
+
+  if (!save_sparse_title_settings(title_id, values)) return false;
+  cfg_root persisted_global;
+  if (!load_settings_root(persisted_global, global_settings_path())) return false;
+  const auto persisted_values = load_sparse_title_settings(title_id, persisted_global);
+  if (persisted_values != values) {
+    rpcsx_android.error("S3CFG game read-back mismatch title=%s path=%s",
+                        std::string(title_id).c_str(), std::string(path).c_str());
+    return false;
