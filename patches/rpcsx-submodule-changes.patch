+std::filesystem::path normalize(const std::string& path) {
+  return std::filesystem::path(path).lexically_normal();
+}
+
+std::string join(const std::string& root, std::string_view child) {
+  return (normalize(root) / child).lexically_normal().string();
+}
+
+bool exists(const std::string& path) {
+  std::error_code error;
+  const bool result = std::filesystem::exists(path, error);
+  return !error && result;
+}
+
+bool isDirectory(const std::string& path) {
+  std::error_code error;
+  const bool result = std::filesystem::is_directory(path, error);
+  return !error && result;
+}
+
+bool isRegularFile(const std::string& path) {
+  std::error_code error;
+  const bool result = std::filesystem::is_regular_file(path, error);
+  return !error && result;
+}
+
+std::optional<std::string> ensureDirectory(const std::string& path) {
+  std::error_code error;
+  std::filesystem::create_directories(path, error);
+  if (error || !isDirectory(path)) {
+    return fmt::format("Failed to create directory %s: %s", path, error.message());
+  }
+  return std::nullopt;
+}
+
+std::optional<std::string> removeTree(const std::string& path) {
+  if (!exists(path)) return std::nullopt;
+  std::error_code error;
+  std::filesystem::remove_all(path, error);
+  if (error) return fmt::format("Failed to remove owned path %s: %s", path, error.message());
+  return std::nullopt;
+}
+
+std::optional<std::string> removeFile(const std::string& path) {
+  if (!exists(path)) return std::nullopt;
+  std::error_code error;
+  std::filesystem::remove(path, error);
+  if (error) return fmt::format("Failed to remove marker %s: %s", path, error.message());
+  return std::nullopt;
+}
+
+std::string makeToken() {
+  const u64 ticks = static_cast<u64>(
+      std::chrono::steady_clock::now().time_since_epoch().count());
+  const u64 counter = s_transactionCounter.fetch_add(1, std::memory_order_relaxed);
+  return fmt::format("%llu-%llu", ticks, counter);
+}
+
+bool isValidToken(std::string_view token) {
+  if (token.empty() || token.size() > 64) return false;
+  for (const char character : token) {
+    if ((character < '0' || character > '9') && character != '-') return false;
+  }
+  return true;
+}
+
+std::string phaseName(StagedGameInstaller::TransactionPhase phase) {
+  switch (phase) {
+  case StagedGameInstaller::TransactionPhase::Prepared:
+    return "prepared";
+  case StagedGameInstaller::TransactionPhase::BackupMoved:
+    return "backup_moved";
+  case StagedGameInstaller::TransactionPhase::NewTitleMoved:
+    return "new_title_moved";
+  }
+  return "invalid";
+}
+
+struct Marker {
+  std::string titleId;
+  std::string token;
+};
+
+std::optional<Marker> readMarker(const std::string& path) {
+  fs::file file(path, fs::read);
+  if (!file || file.size() == 0 || file.size() > 4096) return std::nullopt;
+  const std::string content = file.to_string();
+  Marker marker;
+  std::size_t begin = 0;
+  while (begin < content.size()) {
+    const std::size_t end = content.find('\n', begin);
+    const std::string_view line(content.data() + begin,
+        (end == std::string::npos ? content.size() : end) - begin);
+    if (line.starts_with("title=")) marker.titleId = line.substr(6);
+    if (line.starts_with("token=")) marker.token = line.substr(6);
+    if (end == std::string::npos) break;
+    begin = end + 1;
+  }
+  if (!IsoInstallManifest::isValidTitleId(marker.titleId) || !isValidToken(marker.token)) {
+    return std::nullopt;
+  }
+  return marker;
+}
+} // namespace
