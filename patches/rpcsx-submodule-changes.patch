+class ProgressReporter {
+public:
+  virtual ~ProgressReporter() = default;
+  virtual bool report(long value, long max, const std::string& message) = 0;
+  virtual void failure(const std::string& message) = 0;
+  virtual void success(long value, const std::string& message) = 0;
+};
+
+// StagedGameInstaller owns staging and backup paths and implements transactional install
+class StagedGameInstaller {
+public:
+  StagedGameInstaller(const std::string& configDir,
+                      const std::string& titleId,
+                      const IsoInstallManifest& manifest);
+
+  ~StagedGameInstaller();
+
+  // Accessors for testing and cleanup verification
+  const std::string& stagingPath() const { return m_stagingPath; }
+  const std::string& finalPath() const { return m_finalPath; }
+  const std::string& backupPath() const { return m_backupPath; }
+  const std::string& markerPath() const { return m_markerPath; }
+
+  // Prepare staging directory (outside games tree, same filesystem). Returns error on failure.
+  std::optional<std::string> prepare();
+
+  // Extract all manifest entries into staging. Validates containment, creates dirs, copies files.
+  // Reports progress via reporter: scanning/extracting/verifying phases use distinct messages.
+  // Returns error string on failure; on failure staging remains for caller to cleanup but final untouched.
+  std::optional<std::string> extract(iso_dev& iso, ProgressReporter& reporter);
+
+  // Verify staged tree against manifest and required files. Returns error on mismatch.
+  std::optional<std::string> verify(ProgressReporter* reporter = nullptr);
+
+  // Commit staged to final with backup/rollback/marker protocol. Returns error on failure.
+  // On success, backup is removed, marker removed, staging is now final.
+  std::optional<std::string> commit(ProgressReporter* reporter = nullptr);
+
+  // Cleanup staging (and marker) without touching final/backup. Used on failure.
+  void cleanupStaging();
+
+  // Full transactional helper: prepare + extract + verify + commit
+  std::optional<std::string> install(iso_dev& iso, ProgressReporter& reporter);
+
+  // For tests: inject failure at specific points
+  enum class InjectPoint { None, AfterStagingCreate, DuringExtract, BeforeCommit, AfterBackupRename, AfterStagingRename };
+  void setInjectFailure(InjectPoint point, bool enable) { m_injectPoint = point; m_injectEnabled = enable; }
+
+  // Recovery: scan configDir for stale staging/backup/marker left by crashed installer and clean owned paths.
+  static void recoverStaleTransactions(const std::string& configDir);
+
+  // Utility: check if final exists and is valid
+  bool finalExists() const;
+
+private:
+  std::string m_configDir;
+  std::string m_titleId;
+  std::string m_finalPath;
+  std::string m_stagingPath;
+  std::string m_backupPath;
+  std::string m_markerPath; // transaction marker file
+  IsoInstallManifest m_manifest;
+
+  bool m_prepared = false;
+  bool m_committed = false;
+
+  InjectPoint m_injectPoint = InjectPoint::None;
+  bool m_injectEnabled = false;
+
+  bool shouldInject(InjectPoint p) const { return m_injectEnabled && m_injectPoint == p; }
+
+  std::string generateUniqueStagingPath();
+  std::string generateUniqueBackupPath();
+  std::optional<std::string> writeMarker();
+  void removeMarker();
+  bool isOwnedPath(const std::string& path) const;
+};
