+extern "C" std::string _rpcsx_getTrophiesForTitleFromIso(const char* requested_title_id, int iso_fd)
+{
+    const std::string title_id = requested_title_id ? requested_title_id : "";
+    nlohmann::json unavailable{{"available", false}, {"status", "no_trophy_set"},
+                               {"titleId", title_id}, {"trophies", nlohmann::json::array()},
+                               {"querySource", "iso"}};
+    if (title_id.empty() || iso_fd < 0) return unavailable.dump();
+    try
+    {
+        auto src_file = file_from_android_fd(iso_fd);
+        AtExit at_exit{[&] { src_file.release_handle(); }};
+        if (!src_file) return unavailable.dump();
+        auto opt_iso = iso_dev::open(std::make_unique<file_view_block_dev>(src_file));
+        if (!opt_iso) return unavailable.dump();
+        auto iso = std::move(*opt_iso);
+
+        const char* tropdir_prefixes[] = {"PS3_GAME/TROPDIR", "TROPDIR"};
+        for (const char* prefix : tropdir_prefixes)
+        {
+            fs::dir tropdir;
+            tropdir.reset(iso.open_dir(prefix));
+            if (!tropdir) continue;
+            for (const auto& entry : tropdir)
+            {
+                if (!entry.is_directory || entry.name.empty() || entry.name == "." || entry.name == "..") continue;
+                const std::string tropusr_physical = rpcs3::utils::get_hdd0_dir() + "home/" + Emu.GetUsr() + "/trophy/" + entry.name + "/TROPCONF.SFM";
+                if (fs::is_file(tropusr_physical))
+                {
+                    const std::string mapping_path = tropusr_physical.substr(0, tropusr_physical.rfind('/')) + "/SAMBAS3_TITLE_ID";
+                    if (!fs::is_file(mapping_path) && !title_id.empty())
+                    {
+                        fs::write_file(mapping_path, fs::rewrite, title_id);
+                    }
+                    return android_get_trophies_for_set(entry.name, title_id, "iso");
+                }
+                const std::string trp_path = std::string(prefix) + "/" + entry.name + "/TROPHY.TRP";
+                fs::file trp_file;
+                if (auto raw = iso.open(trp_path, fs::read))
+                {
+                    trp_file.reset(std::move(raw));
+                }
+                if (!trp_file) continue;
+                if (android_install_trophy_set_from_trp(trp_file, entry.name, title_id))
+                {
+                    return android_get_trophies_for_set(entry.name, title_id, "iso");
+                }
+            }
+        }
+    }
+    catch (const std::exception& e)
+    {
+        rpcsx_android.error("getTrophiesForTitleFromIso failed: %s", e.what());
+    }
+    catch (...) {}
+    return unavailable.dump();
+}
