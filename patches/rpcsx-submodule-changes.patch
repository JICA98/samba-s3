@@ -0,0 +1,30 @@
+#pragma once
+
+#include "util/File.h"
+
+#include <atomic>
+#include <functional>
+#include <string>
+
+namespace rpcsx::android {
+struct AtomicFileCopyResult {
+  u64 bytesCopied = 0;
+  std::string error;
+
+  explicit operator bool() const { return error.empty(); }
+};
+
+// Test seam: inject failures for regression tests. Only active when set.
+struct CopyTestHooks {
+  std::function<bool(u64 bytesCopied, u64 requested, u64& bytesRead)> onRead; // return false to simulate short read
+  std::function<bool(u64 bytesCopied, u64 bytesRead, u64& bytesWritten)> onWrite; // return false to simulate short write
+  std::function<bool(const std::string& destination)> onCommit; // return false to simulate commit failure
+};
+
+void setCopyTestHooks(CopyTestHooks hooks);
+void clearCopyTestHooks();
+
+AtomicFileCopyResult copyFileAtomically(fs::file &source,
+                                        const std::string &destination,
+                                        u64 expectedSize);
+} // namespace rpcsx::android
diff --git a/android/src/iso-install-manifest.cpp b/android/src/iso-install-manifest.cpp
new file mode 100644
index 000000000..e467e02b5
--- /dev/null
+++ b/android/src/iso-install-manifest.cpp
@@ -0,0 +1,297 @@
+#include "iso-install-manifest.hpp"
+
+#include "util/File.h"
+#include "util/StrFmt.h"
+
+#include <algorithm>
+#include <cctype>
+#include <filesystem>
+#include <unordered_set>
+#include <unordered_map>
+#include <regex>
+
+namespace rpcsx::android {
+
+namespace {
+bool equalsIgnoreCase(std::string_view a, std::string_view b) {
+  if (a.size() != b.size()) return false;
+  for (size_t i = 0; i < a.size(); ++i) {
+    if (std::tolower((unsigned char)a[i]) != std::tolower((unsigned char)b[i])) return false;
+  }
+  return true;
+}
+
+std::string toLower(std::string s) {
+  for (auto& c : s) c = std::tolower((unsigned char)c);
+  return s;
+}
+} // namespace
+
+bool IsoInstallManifest::isValidTitleId(std::string_view titleId) {
+  static const std::regex re("^[A-Z]{4}[0-9]{5}$");
+  return std::regex_match(std::string(titleId), re);
+}
+
+bool IsoInstallManifest::isValidPathComponent(std::string_view comp) {
+  if (comp.empty()) return false;
+  if (comp == "." || comp == "..") return false;
+  // Reject embedded NUL, '/', '\', absolute/root, drive names
+  for (char c : comp) {
+    if (c == '\0' || c == '/' || c == '\\') return false;
+  }
+  // Reject rooted/absolute: leading '/', leading '\', drive like "C:", or containing ":"
+  if (comp.find(':') != std::string_view::npos) return false;
+  if (comp[0] == '/' || comp[0] == '\\') return false;
+  // Reject components that after normalization would be empty or escape - also check for control?
+  return true;
+}
+
+std::optional<std::string> IsoInstallManifest::normalizeAndValidateRelativePath(const std::string& relativePath, std::string& error) {
+  if (relativePath.empty()) {
+    error = "Empty relative path";
+    return std::nullopt;
+  }
+  // Reject absolute or rooted
+  if (relativePath[0] == '/' || relativePath[0] == '\\' ) {
+    error = fmt::format("Absolute path rejected: %s", relativePath);
+    return std::nullopt;
+  }
+  if (relativePath.find(':') != std::string::npos) {
+    error = fmt::format("Drive/path with colon rejected: %s", relativePath);
+    return std::nullopt;
+  }
+  if (relativePath.find('\0') != std::string::npos) {
+    error = fmt::format("NUL in path rejected: %s", relativePath);
+    return std::nullopt;
+  }
+
+  std::filesystem::path p(relativePath);
+  // Ensure no component is "..", "." or invalid
+  for (auto comp : p) {
+    std::string s = comp.string();
+    if (s == "." || s == "..") {
+      error = fmt::format("Path escapes with dot component: %s", relativePath);
+      return std::nullopt;
+    }
+    if (!isValidPathComponent(s)) {
+      error = fmt::format("Invalid component '%s' in path %s", s, relativePath);
+      return std::nullopt;
+    }
+  }
+
+  auto normalized = p.lexically_normal();
+  std::string normStr = normalized.string();
+  // lexically_normal may produce empty for "." etc., but we already checked
+  if (normStr.empty()) {
+    error = fmt::format("Normalized empty path from %s", relativePath);
+    return std::nullopt;
+  }
+  // Ensure normalized does not start with "/" or ".."
+  if (normStr[0] == '/' || normStr[0] == '\\') {
+    error = fmt::format("Normalized absolute path rejected: %s -> %s", relativePath, normStr);
+    return std::nullopt;
+  }
+  if (normStr == ".." || normStr.rfind("../",0)==0 || normStr.rfind("..\\",0)==0 || normStr.find("/../") != std::string::npos || normStr.find("\\..\\") != std::string::npos) {
+    error = fmt::format("Normalized escapes root: %s -> %s", relativePath, normStr);
+    return std::nullopt;
+  }
+  // Replace backslashes with slashes for consistency
+  std::replace(normStr.begin(), normStr.end(), '\\', '/');
+  return normStr;
+}
+
+bool isPathWithinRoot(const std::string& root, const std::string& candidate) {
+  try {
+    std::filesystem::path rootP(root);
+    std::filesystem::path candP(candidate);
+    rootP = rootP.lexically_normal();
+    candP = candP.lexically_normal();
+    std::string rootS = rootP.string();
+    std::string candS = candP.string();
+    if (rootS.empty() || candS.empty()) return false;
+    // Ensure trailing slash for root
+    if (!rootS.ends_with('/')) rootS += '/';
+    if (candS.size() <= rootS.size()) return false;
+    if (candS.rfind(rootS, 0) != 0) return false;
+    // Ensure the character after root prefix is not escaping
+    return true;
+  } catch (...) {
+    return false;
+  }
+}
+
+std::optional<IsoInstallManifest> IsoInstallManifest::build(iso_dev& iso, std::string& error) {
+  IsoInstallManifest manifest;
+
+  // BFS traversal of ISO directory tree
+  std::vector<std::filesystem::path> workList;
+  std::vector<std::filesystem::path> allDirs; // for later maybe
+  workList.emplace_back("");
+  allDirs.emplace_back("");
+
+  std::unordered_set<std::string> seenNormalized; // lowercased normalized relativePath for duplicate detection
+  std::unordered_set<std::string> seenExact; // exact normalized
+
+  size_t filesCount = 0;
+
+  // We need to track visited iso paths to avoid loops, but ISO tree is acyclic
+
+  // First pass: collect directories and files via BFS
+  struct PendingDir {
+    std::filesystem::path isoPath; // path inside ISO for open_dir
+  };
+
+  std::vector<std::filesystem::path> dirsToProcess;
+  dirsToProcess.emplace_back("");
+
+  // Use index for BFS
+  size_t dirIndex = 0;
+  // Keep list of all relative paths encountered (both dirs and files)
+  // For manifest we need entries for directories (to create) and files
+  std::vector<std::filesystem::path> discoveredDirs;
+  discoveredDirs.emplace_back("");
+
+  while (dirIndex < dirsToProcess.size()) {
+    auto cur = dirsToProcess[dirIndex++];
+
+    fs::dir dir;
+    auto raw = iso.open_dir(cur.string());
+    if (!raw) {
+      // Distinguish between empty directory (valid) vs failed read (invalid)
+      // iso_dev::open_dir returns nullptr on failure; for valid empty dir, it returns virtual_dir with 0 entries (still non-null)
+      // So nullptr indicates failure
+      error = fmt::format("Failed to read ISO directory: %s", cur.string().empty() ? "/" : cur.string());
+      // Propagate underlying fs error if available
+      if (fs::g_tls_error != fs::error::ok) {
+        error += fmt::format(" (%s)", fmt::format("%s", fs::g_tls_error));
+      }
+      return std::nullopt;
+    }
+    dir.reset(std::move(raw));
+
+    for (auto &entry : dir) {
+      if (entry.name == "." || entry.name == "..") {
+        continue;
+      }
+
+      // Validate component
+      if (!isValidPathComponent(entry.name)) {
+        error = fmt::format("Invalid path component '%s' in directory %s", entry.name, cur.string());
+        return std::nullopt;
+      }
+
+      // Skip PS3_UPDATE only at root (cur empty) case-insensitive
+      if (cur.empty() && equalsIgnoreCase(entry.name, "PS3_UPDATE")) {
+        if (entry.is_directory) {
+          // Skip entire subtree: do not add to manifest and do not traverse
+          continue;
+        } else {
+          // Single file PS3_UPDATE at root? skip as well per spec (only directory)
+          continue;
+        }
+      }
+
+      std::filesystem::path rel = cur.empty() ? std::filesystem::path(entry.name) : cur / entry.name;
+      std::string relStr = rel.string();
+      // Normalize '/' separators (filesystem path may use platform sep)
+      std::replace(relStr.begin(), relStr.end(), '\\', '/');
+
+      // Normalize and validate
+      std::string normErr;
+      auto normOpt = normalizeAndValidateRelativePath(relStr, normErr);
+      if (!normOpt) {
+        error = fmt::format("Invalid relative path %s: %s", relStr, normErr);
+        return std::nullopt;
+      }
+      std::string normalized = *normOpt;
+      // Replace back slash with slash
+      std::replace(normalized.begin(), normalized.end(), '\\', '/');
+
+      // Duplicate detection: normalized destination paths
+      std::string lower = toLower(normalized);
+      if (seenNormalized.find(lower) != seenNormalized.end()) {
+        error = fmt::format("Duplicate normalized destination path: %s (from %s)", normalized, relStr);
+        return std::nullopt;
+      }
+      // Also check exact duplicate
+      if (seenExact.find(normalized) != seenExact.end()) {
+        error = fmt::format("Duplicate destination path: %s", normalized);
+        return std::nullopt;
+      }
+      seenNormalized.insert(lower);
+      seenExact.insert(normalized);
+
+      ManifestEntry me;
+      me.relativePath = normalized;
+      if (entry.is_directory) {
+        me.type = ManifestEntryType::Directory;
+        me.expectedSize = 0;
+        manifest.dirEntries.push_back(me);
+        manifest.entries.push_back(me);
+        dirsToProcess.push_back(rel);
+        discoveredDirs.push_back(rel);
+      } else {
+        // For files, expected size is already validated total size (multi-extent summed)
+        // Validate size not overflow? Already checked in iso_dev
+        me.type = ManifestEntryType::File;
+        me.expectedSize = entry.size;
+        manifest.fileEntries.push_back(me);
+        manifest.entries.push_back(me);
+        filesCount++;
+      }
+    }
+  }
+
+  // Verify manifest has at least one file? Not required but ensure not empty
+  // Detect required PARAM.SFO and EBOOT.BIN invariants (but not fail yet; installer will verify after extraction)
+  // However if manifest has no files, treat as error (likely invalid ISO)
+  if (manifest.entries.empty()) {
+    error = "ISO contains no files or directories after filtering";
+    return std::nullopt;
+  }
+
+  // Optional: ensure PARAM.SFO exists in manifest (for early failure)
+  // But spec says installer must fail if missing PARAM.SFO before commit, so we can allow build to succeed
+  // and let verify stage catch missing. We'll just build.
+
+  return manifest;
+}
+
+bool IsoInstallManifest::hasParamSfo() const {
+  for (auto &e : fileEntries) {
+    if (equalsIgnoreCase(e.relativePath, "PS3_GAME/PARAM.SFO")) return true;
+  }
+  return false;
+}
+bool IsoInstallManifest::hasEboot() const {
+  static const std::vector<std::string> candidates = {
+    "EBOOT.BIN",
+    "USRDIR/EBOOT.BIN",
+    "PS3_GAME/USRDIR/EBOOT.BIN",
+    "PS3_GAME/USRDIR/ISO.BIN.EDAT"
+  };
+  for (auto &e : fileEntries) {
+    for (auto &c : candidates) {
+      if (equalsIgnoreCase(e.relativePath, c)) return true;
+    }
+  }
+  return false;
+}
+std::string IsoInstallManifest::paramSfoPath() const {
+  for (auto &e : fileEntries) if (equalsIgnoreCase(e.relativePath, "PS3_GAME/PARAM.SFO")) return e.relativePath;
+  return {};
+}
+std::string IsoInstallManifest::ebootPath() const {
+  static const std::vector<std::string> candidates = {
+    "EBOOT.BIN",
+    "USRDIR/EBOOT.BIN",
+    "USRDIR/ISO.BIN.EDAT",
+    "PS3_GAME/USRDIR/EBOOT.BIN"
+  };
+  for (auto &c : candidates) {
+    for (auto &e : fileEntries) if (equalsIgnoreCase(e.relativePath, c)) return e.relativePath;
+  }
+  return {};
+}
+
+} // namespace rpcsx::android
diff --git a/android/src/iso-install-manifest.hpp b/android/src/iso-install-manifest.hpp
new file mode 100644
index 000000000..eef008649
--- /dev/null
+++ b/android/src/iso-install-manifest.hpp
@@ -0,0 +1,47 @@
+#pragma once
+
+#include "util/File.h"
+#include "dev/iso.hpp"
+
+#include <string>
+#include <vector>
+#include <optional>
+#include <unordered_set>
+
+namespace rpcsx::android {
+
+enum class ManifestEntryType {
+  Directory,
+  File
+};
+
+struct ManifestEntry {
+  ManifestEntryType type;
+  std::string relativePath; // e.g. "PS3_GAME/USRDIR/EBOOT.BIN" lexically normalized with '/'
+  u64 expectedSize = 0; // for files; 0 for directories
+};
+
+struct IsoInstallManifest {
+  std::vector<ManifestEntry> entries; // includes both files and directories
+  std::vector<ManifestEntry> fileEntries; // subset for progress counting
+  std::vector<ManifestEntry> dirEntries;
+
+  // Validates and builds manifest from iso_dev. Returns error string on failure.
+  static std::optional<IsoInstallManifest> build(iso_dev& iso, std::string& error);
+
+  bool hasParamSfo() const;
+  bool hasEboot() const;
+  std::string paramSfoPath() const; // relative path to PARAM.SFO if found
+  std::string ebootPath() const;    // relative path to EBOOT.BIN if found
+
+  // Validation helpers exposed for tests
+  static bool isValidTitleId(std::string_view titleId);
+  static bool isValidPathComponent(std::string_view component);
+  static std::optional<std::string> normalizeAndValidateRelativePath(const std::string& relativePath, std::string& error);
+};
+
+// Checks that destination `candidate` is within `root` after lexical normalization.
+// Both must be absolute or both relative with consistent handling.
+bool isPathWithinRoot(const std::string& root, const std::string& candidate);
+
+} // namespace rpcsx::android
