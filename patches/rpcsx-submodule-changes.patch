+static void android_perf_log_crosscheck_locked(u64 now_us)
+{
+    if (!g_android_perf.sample_ready || g_android_perf.last_crosscheck_log_us != 0 &&
+        now_us - g_android_perf.last_crosscheck_log_us < 1'000'000ull)
+        return;
+
+    g_android_perf.last_crosscheck_log_us = now_us;
+    rpcsx_android.notice("S3PERF crosscheck native_fps=%.3f native_frametime_ms=%.3f",
+                         g_android_perf.fps, g_android_perf.frametime_ms);
+}
