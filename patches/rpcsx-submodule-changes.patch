+	static std::string ppu_manifest_file_digest(const std::string& path)
+	{
+		fs::file file(path);
+		if (!file)
+		{
+			return "missing";
+		}
+
+		usz digest = rpcs3::fnv_seed;
+		std::array<u8, 4096> buffer{};
+
+		while (const usz read = file.read(buffer.data(), buffer.size()))
+		{
+			for (usz i = 0; i < read; ++i)
+			{
+				digest = rpcs3::hash64(digest, buffer[i]);
+			}
+		}
+
+		return std::to_string(digest);
+	}
