+static std::string g_compile_batch_result_json;
+static std::atomic<bool> g_install_batch_canceled{false};
+
+extern "C" void _rpcsx_cancelInstallPpuBatch() {
+  g_install_batch_canceled.store(true, std::memory_order_release);
