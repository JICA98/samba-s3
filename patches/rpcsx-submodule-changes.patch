+extern "C" std::string _rpcsx_patchesList() {
+  nlohmann::json arr = nlohmann::json::array();
+
+  patch_engine::patch_map full_patches;
+  const std::string patches_dir = patch_engine::get_patches_path();
+  patch_engine::load(full_patches, patches_dir + "patch.yml");
+  patch_engine::load(full_patches, patch_engine::get_imported_patch_path());
+
+  const auto config_map = patch_engine::load_config();
+
+  for (const auto &[hash, container] : full_patches) {
+    for (const auto &[description, patch] : container.patch_info_map) {
+
+      bool enabled = false;
+      if (auto hash_it = config_map.find(hash);
+          hash_it != config_map.end()) {
+        if (auto desc_it = hash_it->second.patch_info_map.find(description);
+            desc_it != hash_it->second.patch_info_map.end()) {
+          for (const auto &[title, serials] : desc_it->second.titles) {
+            for (const auto &[serial, app_versions] : serials) {
+              for (const auto &[app_ver, cv] : app_versions) {
+                if (cv.enabled) {
+                  enabled = true;
+                  break;
+                }
+              }
+              if (enabled) break;
+            }
+            if (enabled) break;
+          }
+        }
+      }
+
+      std::vector<std::string> serials_list;
+      std::vector<std::string> titles_list;
+      for (const auto &[title, serials] : patch.titles) {
+        titles_list.push_back(title);
+        for (const auto &[serial, app_versions] : serials) {
+          serials_list.push_back(serial);
+        }
+      }
+
+      nlohmann::json entry;
+      entry["hash"] = hash;
+      entry["name"] = description;
+      entry["author"] = patch.author;
+      entry["version"] = patch.patch_version;
+      entry["notes"] = patch.notes;
+      entry["serials"] = serials_list;
+      entry["titles"] = titles_list;
+      entry["enabled"] = enabled;
+      arr.push_back(entry);
+    }
+  }
+
+  return arr.dump();
+}
+
+extern "C" bool _rpcsx_patchSetEnabled(std::string_view hash,
+                                       std::string_view description,
+                                       bool enabled) {
+  patch_engine::patch_map full_patches;
+  const std::string patches_dir = patch_engine::get_patches_path();
+  patch_engine::load(full_patches, patches_dir + "patch.yml");
+  patch_engine::load(full_patches, patch_engine::get_imported_patch_path());
+
+  auto hash_it = full_patches.find(std::string(hash));
+  if (hash_it == full_patches.end()) {
+    rpcsx_android.error("patchSetEnabled: hash %s not found", hash);
+    return false;
+  }
+
+  auto desc_it = hash_it->second.patch_info_map.find(std::string(description));
+  if (desc_it == hash_it->second.patch_info_map.end()) {
+    rpcsx_android.error("patchSetEnabled: description %s not found under hash %s",
+                        description, hash);
+    return false;
+  }
+
+  auto config_map = patch_engine::load_config();
+  auto &cfg_container = config_map[std::string(hash)];
+  auto &cfg_patch = cfg_container.patch_info_map[std::string(description)];
+
+  for (const auto &[title, serials] : desc_it->second.titles) {
+    for (const auto &[serial, app_versions] : serials) {
+      for (const auto &[app_ver, cv] : app_versions) {
+        auto &leaf =
+            cfg_patch.titles[title][serial][app_ver];
+        leaf.enabled = enabled;
+        if (!enabled) {
+          leaf.config_values.clear();
+        }
+      }
+    }
+  }
+
+  patch_engine::save_config(config_map);
+  return true;
+}
