+class iso_extent_file final : public fs::file_base
+{
+	block_dev* m_device;
+	std::size_t m_first_block;
+	u64 m_length;
+	u64 m_pos = 0;
+	fs::stat_t m_stat;
+
+public:
+	iso_extent_file(block_dev* device, const iso::DirEntry& entry)
+		: m_device(device)
+		, m_first_block(entry.lba.value())
+		, m_length(entry.length.value())
+		, m_stat(entry.to_fs_stat())
+	{
+	}
+
+	fs::stat_t get_stat() override
+	{
+		return m_stat;
+	}
+
+	bool trunc(u64) override
+	{
+		fs::g_tls_error = fs::error::readonly;
+		return false;
+	}
+
+	u64 read(void* buffer, u64 count) override
+	{
+		const u64 result = read_at(m_pos, buffer, count);
+		m_pos += result;
+		return result;
+	}
+
+	u64 read_at(u64 offset, void* buffer, u64 count) override
+	{
+		if (offset >= m_length || count == 0)
+		{
+			return 0;
+		}
+
+		const u64 block_size = m_device->block_size();
+		const u64 requested = std::min(count, m_length - offset);
+		u64 copied = 0;
+		auto* output = static_cast<u8*>(buffer);
+
+		while (copied < requested)
+		{
+			const u64 extent_offset = offset + copied;
+			const u64 block_offset = extent_offset % block_size;
+			const std::size_t block_index = m_first_block + static_cast<std::size_t>(extent_offset / block_size);
+			const u64 remaining = requested - copied;
+
+			if (block_offset == 0 && remaining >= block_size)
+			{
+				constexpr std::size_t max_blocks_per_read = 16 * 1024;
+				const std::size_t block_count = static_cast<std::size_t>(
+					std::min<u64>(remaining / block_size, max_blocks_per_read));
+				const std::size_t blocks_read = m_device->read(block_index, output + copied, block_count);
+				const u64 bytes_read = blocks_read * block_size;
+				copied += bytes_read;
+
+				if (blocks_read != block_count)
+				{
+					break;
+				}
+				continue;
+			}
+
+			std::vector<u8> block(static_cast<std::size_t>(block_size));
+			if (m_device->read(block_index, block.data(), 1) != 1)
+			{
+				break;
+			}
+
+			const u64 bytes_read = std::min(remaining, block_size - block_offset);
+			std::memcpy(output + copied, block.data() + block_offset, static_cast<std::size_t>(bytes_read));
+			copied += bytes_read;
+		}
+
+		return copied;
+	}
+
+	u64 write(const void*, u64) override
+	{
+		fs::g_tls_error = fs::error::readonly;
+		return 0;
+	}
+
+	u64 seek(s64 offset, fs::seek_mode whence) override
+	{
+		const s64 next = whence == fs::seek_set ? offset :
+			whence == fs::seek_cur ? static_cast<s64>(m_pos) + offset :
+			whence == fs::seek_end ? static_cast<s64>(m_length) + offset : -1;
+
+		if (next < 0)
+		{
+			fs::g_tls_error = fs::error::inval;
+			return umax;
+		}
+
+		m_pos = static_cast<u64>(next);
+		return m_pos;
+	}
+
+	u64 size() override
+	{
+		return m_length;
+	}
+};
