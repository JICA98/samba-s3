import struct,os
def parse_idx(path):
    data=open(path,'rb').read()
    print('file', path, 'size', len(data))
    if len(data)<4:
        return
    n=struct.unpack_from('<I', data, 0)[0]
    print('count_u32le', n)
    off=4
    entries=[]
    for i in range(n):
        if off+10>len(data):
            print('truncated at', i, 'off', off)
            break
        foff, fsz, nlen = struct.unpack_from('<IIH', data, off)
        off += 10
        name=data[off:off+nlen]
        off += nlen
        try:
            nm=name.decode('ascii')
        except:
            nm=repr(name)
        entries.append((foff, fsz, nm))
    print('parsed', len(entries), 'remaining', len(data)-off)
    for e in entries:
        if any(x in e[2].lower() for x in ['gtasa','sf','.b','shader','gta3','img','stream']):
            print(f'  {e[0]:10d} {e[1]:10d} {e[2]}')
    print('--- all names ---')
    for e in entries:
        print(f'  {e[0]:10d} {e[1]:10d} {e[2]}')
    return entries
print('==== MAIN IDX ====')
